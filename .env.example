# Bu faylni .env ga nusxalang va qiymatlarni to'ldiring.
# Netlify'da esa: Site settings -> Environment variables.
# .env faylini HECH QACHON git'ga qo'shmang.

# --- Telegram ---
# @BotFather dan olingan asosiy bot tokeni
TELEGRAM_BOT_TOKEN=
# Webhook'ni himoyalash uchun tasodifiy satr (o'zingiz o'ylab topasiz)
TELEGRAM_WEBHOOK_SECRET=
# Xatolar yuboriladigan alohida log-bot tokeni
TELEGRAM_LOG_BOT_TOKEN=
# Log-bot xabar yuboradigan guruh/chat id (masalan -1001234567890)
TELEGRAM_LOG_CHAT_ID=

# --- Sayt manzili ---
# Bot xabarlaridagi havolalar uchun (natija sahifasi). Bo'sh bo'lsa
# so'rov kelgan manzil olinadi (dimed.uz yoki netlify preview).
SITE_URL=https://dimed.uz

# --- Sessiya ---
# Kamida 32 belgili tasodifiy satr: openssl rand -base64 32
SESSION_SECRET=

# --- AWS ---
DIMED_AWS_REGION=us-east-1
DIMED_TABLE_PREFIX=dimed
# DIQQAT: nomlar DIMED_ prefiksi bilan. Netlify AWS_ACCESS_KEY_ID va
# AWS_SECRET_ACCESS_KEY nomlarini o'zi band qilgan — ularni sozlamalarga
# qo'shib bo'lmaydi ("reserved environment variable" xatosi chiqadi).
DIMED_AWS_ACCESS_KEY_ID=
DIMED_AWS_SECRET_ACCESS_KEY=
# Tahlil PDF fayllari saqlanadigan S3 bucket nomi
LAB_S3_BUCKET=

# --- Cron (rejalashtirilgan funksiyalar) ---
# Ixtiyoriy. Cron funksiyalari (/api/notify-results, /api/remind-patients, ...)
# begona so'rovdan himoyalangan: Netlify rejalashtiruvchisi o'tadi, qolganlar
# har 5-7 daqiqada bir marta. Funksiyani qo'lda ishga tushirmoqchi bo'lsangiz
# (masalan ?mode=full) tasodifiy satr qo'ying va so'rovga
# `x-cron-secret: <shu qiymat>` sarlavhasini qo'shing.
CRON_SECRET=

# --- 1C laboratoriya integratsiyasi ---
# 1C tomonga beriladigan API kalit (tasodifiy satr)
LC_API_KEY=

# --- To'lov ---
# Onlayn to'lov global sozlamasi. Bo'sh (standart) — sayt "qabulxona
# kassasida to'lash" rejimida ishlaydi: slot band qilinadi, bemor
# kassaga to'laydi. Payme kodi saqlangan; qaytarish uchun 1 qilinadi
# va quyidagi Payme kalitlari to'ldiriladi (docs/payme-integration.md).
PAYMENT_ENABLED=
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
