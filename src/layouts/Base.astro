---
import '../styles/global.css';
import { site } from '../data/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { LANGS, type Lang } from '../data/i18n';
import { langHref, LOCALE, HTML_LANG } from '../data/home';

interface Props {
  title?: string;
  description?: string;
  /**
   * Ommaviy sahifalar uch tilda alohida yig'iladi — o'sha sahifalar
   * tilni shu yerga beradi. Kabinet sahifalari bermaydi: ular
   * yopiq, indekslanmaydi va tilni brauzerda almashtiradi.
   */
  lang?: Lang;
  /**
   * Havola Telegram yoki boshqa messenjerga tashlanganda oldindan ko'rinishda
   * umumiy muqova rasmi chiqsinmi. Natija sahifasi uchun `false`: u yerda
   * "Shifokorga navbat" rasmi tahlil natijasiga mos kelmaydi va bemorni adashtiradi.
   */
  previewImage?: boolean;
}
const {
  title = site.title,
  description = site.description,
  lang,
  previewImage = true,
} = Astro.props;
const origin = Astro.site ?? new URL('https://dimed.uz');
const canonical = new URL(Astro.url.pathname, origin).href;

/*
  hreflang faqat uch tilda mavjud sahifalarda. Manzil `/ru/...` bo'lsa
  prefiksni olib tashlab, boshqa tillardagi juftlarini hosil qilamiz —
  Google uchun bu sahifalar bir-birining tarjimasi ekani shundan bilinadi.
*/
const bare = Astro.url.pathname.replace(/^\/(ru|en)(?=\/|$)/, '') || '/';
const alternates = lang
  ? LANGS.map((code) => ({ code, href: new URL(langHref(bare, code), origin).href }))
  : [];
const ogImage = new URL('/images/og-cover.jpg', origin).href;
---

<!doctype html>
<html lang={lang ? HTML_LANG[lang] : 'uz'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32x32.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/bricolage-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang ? LOCALE[lang] : 'uz_UZ'} />
    <meta property="og:site_name" content="Dimed" />
    {
      previewImage ? (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={ogImage} />
        </>
      ) : (
        <meta name="twitter:card" content="summary" />
      )
    }
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={HTML_LANG[a.code]} href={a.href} />
      ))
    }
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}
    <script is:inline>
      // Animatsiya faqat JS ishlaganda: sinxron, miltillamasin uchun.
      document.documentElement.classList.add('js-reveal');
    </script>
    <slot name="head" />
  </head>
  <body>
    <div class="aurora" aria-hidden="true"></div>
    <Nav lang={lang} />
    <slot />
    <Footer lang={lang} />

    <script>
      import { revealOnScroll } from '../lib/reveal';
      revealOnScroll();
    </script>

    <style>
      .aurora {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        overflow: hidden;
      }

      .aurora::before,
      .aurora::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        filter: blur(90px);
      }

      .aurora::before {
        width: 640px;
        height: 640px;
        top: -220px;
        right: -140px;
        background: var(--blob-rose);
      }

      .aurora::after {
        width: 560px;
        height: 560px;
        top: 340px;
        left: -220px;
        background: var(--blob-leaf);
      }
    </style>
  </body>
</html>
