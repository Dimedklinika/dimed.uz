---
import { departments } from '../data/departments';
import { activeDoctors as doctors } from '../data/doctors';
import DeptIcon from './DeptIcon.astro';
import { t, type Lang } from '../data/i18n';

interface Props {
  /** Ommaviy sahifada — o'sha sahifaning tili; berilmasa o'zbekcha. */
  lang?: Lang;
}
const { lang = 'uz' } = Astro.props;

/*
  Navbat vidjeti. Bo'sh slotlar `GET /api/slots` dan keladi — band
  vaqtlar DynamoDB dagi navbatlarga qarab chiqarib tashlanadi.
  Kun tugmalari esa hozircha statik `doctors.ts` dagi `workdays` dan
  quriladi (qarang: docs/HANDOFF.md, «Muhim qarorlar», 6-band).

  Boshlang'ich ma'lumot (bo'limlar, shifokorlar) JSON sifatida
  sahifaga qo'yiladi va skript uni o'qiydi — shunda skript odatdagi
  modul bo'lib, `src/lib` dagi yordamchilarni import qila oladi.
*/
const widgetData = JSON.stringify({ departments, doctors });
---

<div class="widget glass" id="navbat-widget" aria-live="polite">
  <div class="widget-head">
    <div class="widget-title">{t('booking.widget.title', lang)}</div>
    <div class="live-dot"><i></i> {t('booking.widget.live', lang)}</div>
  </div>
  <div class="steps" id="wSteps">
    <button class="step-pill on" data-step="1"><span class="n">1</span><span class="lbl">{t('booking.step.dept', lang)}</span></button>
    <button class="step-pill" data-step="2" disabled><span class="n">2</span><span class="lbl">{t('booking.step.doctor', lang)}</span></button>
    <button class="step-pill" data-step="3" disabled><span class="n">3</span><span class="lbl">{t('booking.step.time', lang)}</span></button>
    <button class="step-pill" data-step="4" disabled><span class="n">4</span><span class="lbl">{t('booking.step.patient', lang)}</span></button>
    <button class="step-pill" data-step="5" disabled><span class="n">5</span><span class="lbl">{t('booking.step.confirm', lang)}</span></button>
  </div>
  <div id="wBody"></div>

  {/* Ikonkalar HTML sifatida saqlanadi — vidjet ularni klonlab ishlatadi */}
  <template id="deptIcons">
    {
      departments.map((d) => (
        <span data-icon={d.id}>
          <DeptIcon icon={d.icon} />
        </span>
      ))
    }
  </template>
  <script is:inline type="application/json" id="widgetData" set:html={widgetData} />
</div>

<script>
  // @ts-nocheck — vidjet tarixan oddiy JS; modulga o'tkazildi (importlar uchun).
  import { t } from '../data/i18n';
  import { getLang } from '../lib/lang';
  import { birthDateSelectsHtml, readBirthDate, formatBirthDate } from '../lib/birthdate';
  import { ageOnDate, fitsAgeGroup, ageRejected, ageChip, ageUnfit, toAgeGroup } from '../lib/age';
  import { site } from '../data/site';
  import { parsePhone, formatPhone } from '../lib/phone';

  const { departments, doctors } = JSON.parse(document.getElementById('widgetData').textContent);
  const lang = getLang();
  const tr = (key, vars) => t(key, lang, vars);

  /*
    Sana tugmalari uchun hafta kunlari va oylar. Serverdan emas,
    brauzerdan: sahifa uch tilda alohida yig'ilsa ham vidjet tilni
    `getLang()` dan oladi (`?lang=`, manzil prefiksi yoki kabinetdagi
    tanlov) — shuning uchun uchtasi ham shu yerda turadi.
  */
  const WEEKDAYS = {
    uz: ['Yak', 'Du', 'Se', 'Chor', 'Pay', 'Ju', 'Sh'],
    ru: ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'],
    en: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
  };
  const MONTH_NAMES = {
    uz: ['yanvar', 'fevral', 'mart', 'aprel', 'may', 'iyun',
         'iyul', 'avgust', 'sentabr', 'oktabr', 'noyabr', 'dekabr'],
    ru: ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
         'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'],
    en: ['January', 'February', 'March', 'April', 'May', 'June',
         'July', 'August', 'September', 'October', 'November', 'December'],
  };
  const WD = WEEKDAYS[lang] ?? WEEKDAYS.uz;
  const MONTHS = MONTH_NAMES[lang] ?? MONTH_NAMES.uz;

  /*
    Bo'lim nomi va shifokor lavozimi tarjimasi ma'lumotning o'zida
    keladi (`name_ru`, `job_en`, …) — tarjimasi yozilmagan yangi yozuv
    o'zbekchasicha ko'rinadi, bo'sh emas.
  */
  const deptName = (d) => (lang === 'uz' ? d.name : (d[`name_${lang}`] || d.name));
  const jobText = (d) => (lang === 'uz' ? d.job : (d[`job_${lang}`] || d.job));

  const fmtPrice = (n) => `${n.toLocaleString('ru-RU').replace(/,/g, ' ')} ${tr('lab.sum')}`;
  const BOT_URL = site.telegramBot;
  /** Tanlangan shifokorning yosh cheklovi; belgilanmagan bo'lsa cheklovsiz. */
  const docAgeGroup = () => toAgeGroup(state.doc?.ageGroup);
  // Sana hali tanlanmagan bo'lsa bugunga qarab hisoblanadi — cheklov
  // hech qachon "yoshi noma'lum" deb hammani rad etib qo'ymasin.
  const ageOn = (birthDate, dateKey) => ageOnDate(birthDate, dateKey || dstr(new Date()));
  const pad = (n) => String(n).padStart(2, '0');
  // Server YYYY-MM-DD kutadi.
  const dstr = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  const dlabel = (d) => `${WD[d.getDay()]}, ${d.getDate()}-${MONTHS[d.getMonth()]}`;
  const esc = (s) =>
    String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c);

  // <template> ichidagi tugunlar DocumentFragment'da yashaydi —
  // ularni faqat template.content orqali olish mumkin.
  const iconHtml = {};
  document
    .getElementById('deptIcons')
    .content.querySelectorAll('[data-icon]')
    .forEach((el) => {
      iconHtml[el.dataset.icon] = el.innerHTML;
    });

  /*
    Shifokor ro'yxati: statik `doctors` faqat birinchi, tez chizish
    uchun. Sahifa yuklangach `/api/doctors` dan jonli ro'yxat olinadi —
    admin panelda qo'shilgan/o'chirilgan shifokorlar shunda ko'rinadi.
  */
  let docs = doctors;
  const docById = (id) => docs.find((d) => d.id === id);

  /*
    Ish kunlari: shifokor jadvalini kabinetidan o'zgartirishi mumkin,
    shuning uchun statik ro'yxat faqat birinchi chizishga ishlatiladi —
    /api/slots javobi kelishi bilan server ma'lumoti ustun bo'ladi.
  */
  const serverWorkdays = {};
  const workdaysOf = (doc) => serverWorkdays[doc.id] ?? doc.workdays;
  const sameDays = (a, b) => [...a].sort().join() === [...b].sort().join();

  const nextDays = (doc) => {
    const out = [];
    const wd = workdaysOf(doc);
    const now = new Date();
    for (let i = 0; i < 7; i++) {
      const d = new Date(now);
      d.setDate(now.getDate() + i);
      out.push({ date: d, ok: wd.includes(d.getDay()) });
    }
    return out;
  };

  /*
    Maxfiylik siyosatiga rozilik (B4). Bir marta berilgani brauzerda
    eslab qolinadi — checkbox oldindan belgilangan turadi, lekin har
    bronda ko'rinadi va serverga ham yuboriladi.
  */
  const PRIVACY_KEY = 'dimed_privacy_ok';
  const readPrivacy = () => {
    try {
      return localStorage.getItem(PRIVACY_KEY) === '1';
    } catch {
      return false;
    }
  };

  /*
    Kirgan hisob administratormi (sinov bron uchun "to'lovsiz" belgisi).
    Header allaqachon /api/session javobini sessionStorage'da 5 daqiqa
    saqlaydi (Nav.astro) — avval shuni ishlatamiz, bo'lmasa so'raymiz.
    Bu faqat tugmani ko'rsatish uchun: ruxsatni server tekshiradi.
  */
  const isAdminSession = async () => {
    try {
      const cached = JSON.parse(sessionStorage.getItem('dimed_session') ?? 'null');
      if (cached?.data && Date.now() - cached.t < 5 * 60_000) return cached.data.admin === true;
    } catch {
      /* xotira yopiq — so'raymiz */
    }
    try {
      const res = await fetch('/api/session', { credentials: 'same-origin' });
      return res.ok && (await res.json()).admin === true;
    } catch {
      return false;
    }
  };

  const state = { step: 1, deptId: null, doc: null, date: null, dateLabel: null, time: null, booked: null,
    serviceId: 'main',
    patientId: null, patientName: null, patientBirthDate: null, privacyAccepted: readPrivacy() };

  /*
    Xizmat: shifokorning asosiy qabuli ('main', narxi `doc.price`) yoki
    admin qo'shgan xizmatlardan biri (massaj, UZI, qayta ko'rik ...).
    Xizmati yo'q shifokorda tanlov ko'rsatilmaydi — hammasi avvalgidek.
    Narxni server o'zi xizmatdan oladi; bu yerdagi faqat ko'rsatish uchun.
  */
  const servicesOf = (doc) => doc?.services ?? [];
  const chosenService = () => {
    const doc = state.doc;
    const found = servicesOf(doc).find((s) => s.id === state.serviceId);
    return found
      ? { id: found.id, name: found.name, price: found.price, followupDays: found.followupDays ?? null, main: false }
      : { id: 'main', name: '', price: doc.price, followupDays: null, main: true };
  };
  const priceLabel = (price) => (price === 0 ? tr('booking.service.free') : fmtPrice(price));

  /*
    To'lov rejimi: 'at_clinic' (kassada) yoki 'online' (Payme). Uni server
    biladi (PAYMENT_ENABLED) va `/api/doctors` javobining `x-payment-mode`
    sarlavhasida aytadi. Bilinguncha — kassada (to'lov o'chiq holati).
    Sahifadagi `[data-pay-text]` matnlari (bosh sahifa "Qanday ishlaydi")
    ham shunga qarab almashadi.
  */
  let payMode = 'at_clinic';
  function applyPayMode(mode) {
    const changed = mode !== payMode;
    payMode = mode;
    document.querySelectorAll('[data-pay-text]').forEach((el) => {
      el.textContent = mode === 'online' ? el.dataset.online : el.dataset.clinic;
    });
    if (changed && state.step === 5 && !state.booked) render();
  }
  const serviceChooserHtml = (doc) => {
    const list = servicesOf(doc);
    if (!list.length) return '';
    const items = [{ id: 'main', name: tr('booking.service.main'), price: doc.price, followupDays: null }, ...list];
    return `<div class="pane-label sub">${esc(tr('booking.pickService'))}</div><div class="svc-row">${items
      .map(
        (s) => `<button type="button" class="svc-pill${s.id === state.serviceId ? ' on' : ''}" data-s="${esc(s.id)}">
          <b>${esc(s.name)}</b>
          <small>${esc(priceLabel(s.price))}${
            s.followupDays ? ` · ${esc(tr('booking.service.followup', { n: s.followupDays }))}` : ''
          }</small>
        </button>`,
      )
      .join('')}</div>`;
  };

  /*
    Telefonga bog'langan bemorlar. Bir raqamdan butun oila foydalanadi
    (ota-ona bolasini o'z raqami bilan yozdiradi), shuning uchun
    navbat kim uchun olinayotgani so'raladi. Ro'yxat bir marta
    olinadi; kirmagan foydalanuvchida null bo'lib qoladi va savol
    umuman ko'rsatilmaydi — u baribir kirish sahifasiga tushadi.
  */
  let patients = null;
  /** Oxirgi urinish nega bo'lmadi: 'auth' — kirmagan, 'network' — ulanmadi. */
  let patientsError = null;

  async function loadPatients() {
    if (patients) return patients;
    patientsError = null;
    try {
      const res = await fetch('/api/patients', { credentials: 'same-origin' });
      if (!res.ok) {
        patientsError = res.status === 401 ? 'auth' : 'network';
        return null;
      }
      const data = await res.json();
      patients = data;
      if (!state.patientId) {
        const pick = data.patients.find((p) => p.id === data.activeId)
          ?? (data.patients.length === 1 ? data.patients[0] : null);
        if (pick) {
          state.patientId = pick.id;
          state.patientName = pick.name;
          state.patientBirthDate = pick.birthDate;
        }
      }
      return data;
    } catch {
      patientsError = 'network';
      return null;
    }
  }
  const wBody = document.getElementById('wBody');
  const stepPills = [...document.querySelectorAll('#wSteps .step-pill')];

  function setStep(n) {
    state.step = n;
    stepPills.forEach((p, i) => {
      p.classList.toggle('on', i + 1 === n);
      p.classList.toggle('done', i + 1 < n);
      p.disabled = i + 1 > n;
    });
    render();
  }
  stepPills.forEach((p, i) =>
    p.addEventListener('click', () => {
      if (i + 1 < state.step) {
        state.booked = null;
        setStep(i + 1);
      }
    }),
  );

  /** Bo'sh slotlar serverdan olinadi — band vaqtlar bazadan keladi. */
  async function fetchSlots(doctorId, dateKey) {
    const res = await fetch(`/api/slots?doctor=${encodeURIComponent(doctorId)}&date=${dateKey}`);
    if (!res.ok) throw new Error(`slots ${res.status}`);
    return res.json();
  }

  function slotsHtml(slots) {
    if (!slots.length) {
      return `<p class="slot-empty">${esc(tr('booking.slot.none'))}</p>`;
    }
    return slots
      .map(
        (s) =>
          `<button class="slot-btn${s.free ? '' : ' busy'}" data-t="${s.time}"${s.free ? '' : ' disabled'}>${s.time}</button>`,
      )
      .join('');
  }

  function render() {
    if (state.step === 1) {
      wBody.innerHTML =
        `<div class="pane-label">${esc(tr('booking.pickDept'))}</div><div class="dept-grid">` +
        departments
          .map(
            (d) => `<button class="dept-btn" data-id="${d.id}">
              <span class="ic">${iconHtml[d.id] ?? ''}</span>
              <span>${esc(deptName(d))}<small>${docs.filter((x) => x.deptId === d.id).length} ${esc(tr('booking.doctorCount'))}</small></span>
            </button>`,
          )
          .join('') +
        '</div>';
      wBody.querySelectorAll('.dept-btn').forEach((b) =>
        b.addEventListener('click', () => {
          state.deptId = b.dataset.id;
          state.doc = null;
          setStep(2);
        }),
      );
    } else if (state.step === 2) {
      const list = docs.filter((d) => d.deptId === state.deptId);
      wBody.innerHTML =
        `<div class="pane-label">${esc(tr('booking.pickDoctor'))}</div><div class="doc-list">` +
        list
          .map(
            (d) => `<button class="doc-btn" data-id="${d.id}">
              <img src="${d.photo}" alt="" width="42" height="42" loading="lazy">
              <span><span class="nm">${esc(d.name)}</span><br><span class="jb">${esc(jobText(d))}</span></span>
              <span class="tags">${
                ageChip(toAgeGroup(d.ageGroup), lang)
                  ? `<span class="age-tag">${esc(ageChip(toAgeGroup(d.ageGroup), lang))}</span>`
                  : ''
              }${
                d.ratingCount ? `<span class="rate-tag" title="${d.ratingCount} ta baho">★ ${d.ratingAvg}</span>` : ''
              }<span class="slot-tag">${d.slotMinutes} ${esc(tr('booking.minutes.short'))}</span></span>
            </button>`,
          )
          .join('') +
        `</div><button class="back-link">${esc(tr('booking.back.depts'))}</button>`;
      wBody.querySelectorAll('.doc-btn').forEach((b) =>
        b.addEventListener('click', () => {
          state.doc = docById(b.dataset.id);
          state.serviceId = 'main';
          state.date = null;
          state.time = null;
          setStep(3);
        }),
      );
      wBody.querySelector('.back-link').addEventListener('click', () => setStep(1));
    } else if (state.step === 3) {
      renderDatesAndSlots();
    } else if (state.step === 4) {
      renderPatient();
    } else if (state.step === 5) {
      renderCheckout();
    }
  }

  function renderDatesAndSlots() {
    const doc = state.doc;
    const usedWorkdays = workdaysOf(doc);
    const days = nextDays(doc);
    const workdays = days.filter((x) => x.ok);
    if (!state.date && workdays.length) state.date = dstr(workdays[0].date);

    // Xizmati yo'q shifokorda sarlavha avvalgidek bitta qator; bo'lsa — nom, xizmat tanlovi, keyin "qachon".
    const chooser = serviceChooserHtml(doc);
    const head = chooser
      ? `<div class="pane-label">${esc(doc.name)}</div>${chooser}<div class="pane-label sub">${esc(tr('booking.pickWhen'))}</div>`
      : `<div class="pane-label">${esc(doc.name)} · ${esc(tr('booking.pickWhen'))}</div>`;

    wBody.innerHTML =
      `${head}<div class="date-row">` +
      days
        .map(
          (x) => `<button class="date-pill${dstr(x.date) === state.date ? ' on' : ''}"
            data-d="${dstr(x.date)}" data-l="${dlabel(x.date)}"${x.ok ? '' : ' disabled'}>
            ${WD[x.date.getDay()]}<b>${x.date.getDate()}</b></button>`,
        )
        .join('') +
      `</div><div class="slot-grid" id="slotGrid"></div>
       <div class="slot-legend"><span class="free"><i></i>${esc(tr('booking.slot.free'))}</span><span class="busy"><i></i>${esc(tr('booking.slot.busy'))}</span></div>
       <button class="back-link">${esc(tr('booking.back.doctor'))}</button>`;

    const grid = wBody.querySelector('#slotGrid');

    // Xizmat tanlovi: faqat belgi almashadi (vaqtlar o'zgarmaydi), narx 5-qadamda ko'rinadi.
    wBody.querySelectorAll('.svc-pill').forEach((pill) =>
      pill.addEventListener('click', () => {
        state.serviceId = pill.dataset.s;
        wBody.querySelectorAll('.svc-pill').forEach((p) => p.classList.toggle('on', p === pill));
      }),
    );

    const selectDate = (dateKey) => {
      state.date = dateKey;
      wBody
        .querySelectorAll('.date-pill')
        .forEach((p) => p.classList.toggle('on', p.dataset.d === dateKey));
    };

    const paint = async (dateKey, { autoAdvance = false } = {}) => {
      grid.innerHTML = `<p class="slot-empty">${esc(tr('common.loading'))}</p>`;
      let data;
      try {
        data = await fetchSlots(doc.id, dateKey);
      } catch {
        grid.innerHTML = `<p class="slot-empty">${esc(tr('booking.slot.failed'))}</p>`;
        return;
      }

      /*
        Serverdagi ish kunlari statik ro'yxatdan farq qilsa, kun
        tugmalari qaytadan chiziladi. Takrorlanmaydi: qayta chizishda
        `usedWorkdays` server ro'yxatiga teng bo'lib qoladi.
      */
      if (Array.isArray(data.workdays) && !sameDays(usedWorkdays, data.workdays)) {
        serverWorkdays[doc.id] = data.workdays;
        state.date = null;
        renderDatesAndSlots();
        return;
      }

      const slots = data.slots ?? [];

      /*
        Bugungi kunning slotlari o'tib ketgan bo'lishi mumkin —
        bunda foydalanuvchini keyingi ish kuniga o'tkazamiz.
      */
      if (autoAdvance && !slots.some((s) => s.free)) {
        const next = workdays.find((x) => dstr(x.date) > dateKey);
        if (next) {
          selectDate(dstr(next.date));
          await paint(dstr(next.date), { autoAdvance: true });
          return;
        }
      }

      grid.innerHTML = slotsHtml(slots);
      const firstFree = grid.querySelector('.slot-btn:not(.busy)');
      if (firstFree) grid.scrollTop = Math.max(0, firstFree.offsetTop - grid.offsetTop - 8);

      grid.querySelectorAll('.slot-btn:not(.busy)').forEach((s) =>
        s.addEventListener('click', () => {
          state.time = s.dataset.t;
          const pill = wBody.querySelector('.date-pill.on');
          state.dateLabel = pill ? pill.dataset.l : state.date;
          setStep(4);
        }),
      );
    };

    wBody.querySelectorAll('.date-pill:not([disabled])').forEach((p) =>
      p.addEventListener('click', () => {
        selectDate(p.dataset.d);
        paint(p.dataset.d);
      }),
    );

    if (state.date) paint(state.date, { autoAdvance: true });
    else grid.innerHTML = `<p class="slot-empty">${esc(tr('booking.slot.noDays'))}</p>`;
  }

  /**
   * Bemor ro'yxatidagi bitta qator: ism + tug'ilgan sana (yoki yo'qligi).
   * Shifokorning yosh chekloviga tushmagan bemor darhol xiralashadi —
   * bosib ko'rgandan keyin emas, ro'yxatning o'zidayoq ko'rinadi.
   */
  const patientItem = (p) => {
    const fits = !p.birthDate || fitsAgeGroup(docAgeGroup(), ageOn(p.birthDate, state.date));
    const note = p.birthDate
      ? esc(formatBirthDate(p.birthDate, lang))
      : esc(tr('booking.birthDate.missingFor'));
    return `<button class="who-item${p.id === state.patientId ? ' on' : ''}${fits ? '' : ' unfit'}" data-pick="${esc(p.id)}">
      <span class="who-nm">${esc(p.name)}</span>
      <small class="who-bd${p.birthDate ? '' : ' none'}">${note}${
        fits ? '' : ` · ${esc(ageUnfit(docAgeGroup(), lang))}`
      }</small>
    </button>`;
  };

  /*
    4-qadam — bemor ma'lumotlari. Bir telefondan butun oila foydalanadi
    (ota-ona bolasini o'z raqami bilan yozdiradi), shuning uchun bemor
    alohida qadamda tanlanadi: ro'yxatdan yoki yangi odam qo'shib.
    Tug'ilgan sana majburiy (B1): yo'q bo'lsa shu yerda so'raladi va
    bemor yozuviga saqlanadi.
  */
  /*
    4-qadam — bemor ma'lumotlari. Bir telefondan butun oila foydalanadi
    (ota-ona bolasini o'z raqami bilan yozdiradi), shuning uchun bemor
    alohida qadamda tanlanadi: ro'yxatdan yoki yangi odam qo'shib.

    Bu qadamdan bemor tanlanmasdan o'tib bo'lmaydi — 5-qadam
    ("Tasdiqlash") faqat `proceed()` orqali ochiladi. Kirmagan
    foydalanuvchi shu yerning o'zida Telegram orqali kiradi: avval
    sahifadan haydab yuborilardi va tanlov butunlay o'tkazib
    yuborilardi.
  */
  async function renderPatient() {
    const data = await loadPatients();
    // Kirmagan bo'lsa — shu qadamning o'zida kirish; ulanish uzilgan
    // bo'lsa kirish oynasini ko'rsatish chalg'itadi, qayta urinish beramiz.
    if (!data) return patientsError === 'network' ? renderPatientsFailed() : renderLogin();

    wBody.innerHTML = `<div class="pane-label">${esc(tr('booking.whoFor'))}</div>
      <div class="who-list" id="whoList"><p class="slot-empty">${esc(tr('common.loading'))}</p></div>
      <button class="btn btn-ghost w-full" id="whoNew" type="button">+ Boshqa odam</button>
      <div class="who-form" id="whoForm" hidden>
        <input id="w-last" type="text" placeholder="${esc(tr('booking.field.lastName'))}" autocomplete="family-name" />
        <input id="w-first" type="text" placeholder="${esc(tr('booking.field.firstName'))}" autocomplete="given-name" />
        <input id="w-mid" type="text" placeholder="${esc(tr('booking.field.patronymic'))}" />
        <div class="fld-label">${esc(tr('booking.birthDate'))} *</div>
        ${birthDateSelectsHtml('new', lang)}
        <button class="btn w-full" id="whoSave" type="button">Saqlash va davom etish</button>
      </div>
      <div class="who-form" id="whoBirth" hidden>
        <div class="fld-label" id="whoBirthLabel"></div>
        ${birthDateSelectsHtml('fix', lang)}
        <button class="btn w-full" id="whoBirthSave" type="button">Saqlash va davom etish</button>
      </div>
      <label class="consent">
        <input type="checkbox" id="privacyOk"${state.privacyAccepted ? ' checked' : ''} />
        <span>${tr('booking.privacy.text', {
          link: `<a href="/maxfiylik" target="_blank" rel="noopener">${esc(tr('booking.privacy.linkText'))}</a>`,
        })}</span>
      </label>
      <p class="book-msg" id="whoMsg" role="status" aria-live="polite"></p>
      <button class="back-link">${esc(tr('booking.back.time'))}</button>`;

    wBody.querySelector('.back-link').addEventListener('click', () => {
      state.time = null;
      setStep(3);
    });

    const msg = wBody.querySelector('#whoMsg');
    const form = wBody.querySelector('#whoForm');
    const birthForm = wBody.querySelector('#whoBirth');
    const newBtn = wBody.querySelector('#whoNew');
    const setMsg = (text, kind = '') => {
      msg.textContent = text;
      msg.className = `book-msg${kind ? ` ${kind}` : ''}`;
    };

    const openForm = () => {
      form.hidden = false;
      birthForm.hidden = true;
      newBtn.hidden = true;
      wBody.querySelector('#w-last').focus();
    };

    const privacyBox = wBody.querySelector('#privacyOk');
    privacyBox.addEventListener('change', () => {
      state.privacyAccepted = privacyBox.checked;
      try {
        localStorage.setItem(PRIVACY_KEY, privacyBox.checked ? '1' : '0');
      } catch {
        /* xotira yopiq bo'lsa ham joriy bronda ishlaydi */
      }
      if (privacyBox.checked) setMsg('');
    });

    /** Rozilik bo'lmasa davom etilmaydi (B4). */
    const privacyOk = () => {
      if (state.privacyAccepted) return true;
      setMsg(tr('booking.privacy.required'), 'error');
      privacyBox.focus();
      return false;
    };

    /*
      Shifokorning yosh cheklovi: pediatr kattani, kattalar shifokori
      bolani qabul qilmaydi. Server ham shuni tekshiradi — bu yerdagisi
      bemor 5-qadamga bekorga o'tib, xatoni oxirida ko'rmasligi uchun.
    */
    const fitsDoctor = (patient) =>
      fitsAgeGroup(docAgeGroup(), patient.birthDate ? ageOn(patient.birthDate, state.date) : null);

    const proceed = (patient) => {
      if (!privacyOk()) return;
      if (!fitsDoctor(patient)) return setMsg(ageRejected(docAgeGroup(), lang), 'error');
      state.patientId = patient.id;
      state.patientName = patient.name;
      state.patientBirthDate = patient.birthDate;
      // Tanlov eslab qolinadi — keyingi safar oldindan belgilangan turadi.
      fetch('/api/patients', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'select', id: patient.id }),
      }).catch(() => {});
      setStep(5);
    };

    /*
      Bemorda tug'ilgan sana bo'lmasa (eski yozuv yoki 1C'da bo'sh) —
      davom etishdan oldin shu yerda so'raladi.
    */
    let fixing = null;
    const choose = (patient) => {
      if (patient.birthDate) return proceed(patient);
      fixing = patient;
      form.hidden = true;
      newBtn.hidden = false;
      birthForm.hidden = false;
      wBody.querySelector('#whoBirthLabel').textContent = `${patient.name} — ${tr('booking.birthDate')} *`;
      setMsg(tr('booking.birthDate.missingFor'));
      wBody.querySelectorAll('.who-item').forEach((b) => b.classList.toggle('on', b.dataset.pick === patient.id));
      birthForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    if (!data.patients.length) {
      wBody.querySelector('#whoList').innerHTML =
        '<p class="slot-empty">Klinikada yozuvingiz topilmadi — ism-familiyangizni kiriting.</p>';
      newBtn.hidden = true;
      form.hidden = false;
    } else {
      wBody.querySelector('#whoList').innerHTML = data.patients.map(patientItem).join('');
      wBody.querySelectorAll('[data-pick]').forEach((b) =>
        b.addEventListener('click', () => {
          const found = data.patients.find((p) => p.id === b.dataset.pick);
          if (found) choose(found);
        }),
      );
    }

    newBtn.addEventListener('click', openForm);

    const post = (body) =>
      fetch('/api/patients', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });

    wBody.querySelector('#whoSave').addEventListener('click', async () => {
      const lastName = wBody.querySelector('#w-last').value.trim();
      const firstName = wBody.querySelector('#w-first').value.trim();
      const patronymic = wBody.querySelector('#w-mid').value.trim();
      const birthDate = readBirthDate(form, 'new');

      if (!lastName || !firstName) return setMsg(tr('booking.field.nameRequired'), 'error');
      if (!birthDate) return setMsg(tr('booking.birthDate.required'), 'error');
      if (!privacyOk()) return;
      // Yoshi to'g'ri kelmasa — bemorni bekorga qo'shib o'tirmaymiz.
      if (!fitsDoctor({ birthDate })) return setMsg(ageRejected(docAgeGroup(), lang), 'error');

      setMsg('Saqlanmoqda…');
      try {
        const res = await post({ action: 'add', firstName, lastName, patronymic, birthDate });
        const body = await res.json();
        if (!res.ok) return setMsg(body.error ?? tr('booking.saveFailed'), 'error');
        patients.patients.push(body.patient);
        proceed(body.patient);
      } catch {
        setMsg(tr('common.error.network'), 'error');
      }
    });

    wBody.querySelector('#whoBirthSave').addEventListener('click', async () => {
      if (!fixing) return;
      const birthDate = readBirthDate(birthForm, 'fix');
      if (!birthDate) return setMsg(tr('booking.birthDate.required'), 'error');
      if (!privacyOk()) return;
      if (!fitsDoctor({ birthDate })) return setMsg(ageRejected(docAgeGroup(), lang), 'error');

      setMsg('Saqlanmoqda…');
      try {
        const res = await post({ action: 'birthDate', id: fixing.id, birthDate });
        const body = await res.json();
        if (!res.ok) return setMsg(body.error ?? 'Saqlab boʻlmadi.', 'error');
        // Ro'yxatdagi yozuv ham yangilanadi — orqaga qaytilsa sana turadi.
        const at = patients.patients.findIndex((p) => p.id === fixing.id);
        if (at !== -1) patients.patients[at] = body.patient;
        proceed(body.patient);
      } catch {
        setMsg(tr('common.error.network'), 'error');
      }
    });
  }

  /** Bemor ro'yxatini olib bo'lmadi (kirish emas, ulanish muammosi). */
  function renderPatientsFailed() {
    wBody.innerHTML = `<div class="pane-label">${esc(tr('booking.whoFor'))}</div>
      <p class="book-msg error">${esc(tr('common.error.network'))}</p>
      <button class="btn w-full" id="whoRetry" type="button">${esc(tr('common.retry'))}</button>
      <button class="back-link">${esc(tr('booking.back.time'))}</button>`;
    wBody.querySelector('#whoRetry').addEventListener('click', () => renderPatient());
    wBody.querySelector('.back-link').addEventListener('click', () => {
      state.time = null;
      setStep(3);
    });
  }

  /*
    Kirmagan foydalanuvchi uchun 4-qadamning o'zida kirish: botdan
    kod olinadi va shu yerda kiritiladi. Muvaffaqiyatli kirgach
    tanlangan bo'lim/shifokor/vaqt saqlanib qoladi va bemor ro'yxati
    o'sha zahoti shu qadamda ochiladi.
  */
  function renderLogin() {
    wBody.innerHTML = `<div class="pane-label">${esc(tr('booking.login.title'))}</div>
      <p class="login-lede">${esc(tr('booking.login.lede'))}</p>
      <div class="login-steps">
        <span>${esc(tr('booking.login.botStep'))}</span>
        <a class="btn btn-sm tg" href="${BOT_URL}" target="_blank" rel="noopener">${esc(tr('booking.login.botBtn'))}</a>
      </div>
      <label class="fld-label" for="wPhone">${esc(tr('booking.login.phone'))}</label>
      <input class="login-inp" id="wPhone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+998 90 123 45 67" />
      <label class="fld-label" for="wCode">${esc(tr('booking.login.code'))}</label>
      <input class="login-inp code" id="wCode" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" />
      <p class="book-msg" id="loginMsg" role="status" aria-live="polite"></p>
      <button class="btn w-full" id="wLogin" type="button">${esc(tr('booking.login.button'))}</button>
      <button class="back-link">${esc(tr('booking.back.time'))}</button>`;

    wBody.querySelector('.back-link').addEventListener('click', () => {
      state.time = null;
      setStep(3);
    });

    const msg = wBody.querySelector('#loginMsg');
    const phone = wBody.querySelector('#wPhone');
    const code = wBody.querySelector('#wCode');
    const btn = wBody.querySelector('#wLogin');
    const setMsg = (text, kind = '') => {
      msg.textContent = text;
      msg.className = `book-msg${kind ? ` ${kind}` : ''}`;
    };

    code.addEventListener('input', () => {
      code.value = code.value.replace(/\D/g, '').slice(0, 6);
    });
    phone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') code.focus();
    });
    code.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') btn.click();
    });

    phone.addEventListener('blur', () => {
      const ok = parsePhone(phone.value);
      if (ok.ok) phone.value = formatPhone(ok.value);
    });

    btn.addEventListener('click', async () => {
      const checked = parsePhone(phone.value);
      if (!checked.ok) {
        setMsg(checked.error, 'error');
        return phone.focus();
      }
      if (code.value.length !== 6) {
        setMsg(tr('booking.login.codeRequired'), 'error');
        return code.focus();
      }

      btn.disabled = true;
      setMsg(tr('booking.login.working'));
      try {
        const res = await fetch('/api/auth-verify', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ phone: checked.value, code: code.value }),
        });
        const body = await res.json();
        if (!res.ok) {
          setMsg(body.error ?? tr('booking.login.failed'), 'error');
          code.value = '';
          code.focus();
          return;
        }
        // Header'dagi "kim kirgan" keshi (C1) eskirmasin.
        try {
          sessionStorage.removeItem('dimed_session');
        } catch {
          /* xotira yopiq bo'lsa ham bron davom etadi */
        }
        patients = null;
        await renderPatient();
      } catch {
        setMsg(tr('common.error.network'), 'error');
      } finally {
        btn.disabled = false;
      }
    });
  }

  function renderCheckout() {
    const d = state.doc;
    const svc = chosenService();
    // Bron qilingandan keyin narxni server tasdiqlagan qiymatdan olamiz.
    const price = state.booked?.appointment?.price ?? svc.price;
    const serviceName = state.booked ? state.booked.appointment?.serviceName : svc.main ? null : svc.name;

    // Narx faqat raqam (so'msiz) — "… X soʻm toʻlaysiz" matniga qo'yish uchun.
    const priceNumber = price.toLocaleString('ru-RU').replace(/,/g, ' ');
    // Bepul xizmatda "kassaga to'laysiz" deyilmaydi.
    const payNote = price === 0 ? tr('booking.confirm.free') : tr('booking.confirm.payAtDesk', { price: priceNumber });
    /*
      Onlayn to'lov yoqilgan (server `/api/doctors` da aytadi) va qabul pulli
      bo'lsa, "Tasdiqlash" Payme sahifasiga olib boradi — matn va tugma ham
      shuni aytadi. Bepul xizmat Payme'ga o'tmaydi (server ham shunday).
    */
    const payOnline = payMode === 'online' && price > 0;
    const onlineNote = tr('booking.confirm.payOnline', { price: priceNumber });
    const serviceRow = serviceName
      ? `<div class="sum-row"><span class="k">${esc(tr('booking.summary.service'))}</span><span class="v">${esc(serviceName)}</span></div>`
      : '';

    if (state.booked) {
      const b = state.booked;
      wBody.innerHTML = `<div class="success">
        <div class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12.5l5 5 10-11"/></svg></div>
        <h4>${esc(tr('booking.success.title'))}</h4>
        <p>${esc(b.mode === 'at_clinic' ? payNote : tr('booking.paid'))}</p>
        <div class="sum-card" style="margin-top:14px;text-align:left">
          ${state.patientName ? `<div class="sum-row"><span class="k">${esc(tr('booking.summary.patient'))}</span><span class="v">${esc(state.patientName)}</span></div>` : ''}
          <div class="sum-row"><span class="k">${esc(tr('booking.summary.doctor'))}</span><span class="v">${esc(d.name)}</span></div>
          ${serviceRow}
          <div class="sum-row"><span class="k">${esc(tr('booking.summary.when'))}</span><span class="v">${state.dateLabel} · ${state.time}</span></div>
          <div class="sum-row total"><span class="k">${esc(tr('booking.confirm.price'))}</span><span class="v">${esc(priceLabel(price))}</span></div>
        </div>
        <p class="pay-note">${esc(tr('booking.success.telegram'))}</p>
        <div style="display:flex;gap:10px;justify-content:center;margin-top:14px;flex-wrap:wrap">
          <a class="btn sm" href="/kabinet">${esc(tr('booking.success.cabinet'))}</a>
          <button class="btn btn-ghost btn-sm" id="resetBtn">${esc(tr('booking.success.again'))}</button>
        </div>
      </div>`;
      wBody.querySelector('#resetBtn').addEventListener('click', () => {
        Object.assign(state, { step: 1, deptId: null, doc: null, serviceId: 'main', date: null, time: null, booked: null });
        setStep(1);
      });
      return;
    }

    /*
      Tasdiqlash qadami (B2): narx katta ko'rsatiladi. Kassada to'lash
      rejimida — "qabulxona kassasiga to'laysiz" va Tasdiqlash tugmasi;
      onlayn rejimda (PAYMENT_ENABLED=1) — "Payme orqali to'laysiz" va
      "Payme orqali to'lash" tugmasi, javobdagi redirectUrl to'lovga olib boradi.
    */
    wBody.innerHTML = `<div class="pane-label">${esc(tr('booking.confirm.title'))}</div>
      <div class="price-box">
        <div class="price-lab">${esc(tr('booking.confirm.price'))}</div>
        <div class="price-big">${esc(priceLabel(price))}</div>
        <div class="price-note">${esc(payOnline ? onlineNote : payNote)}</div>
      </div>
      <div class="sum-card">
        <div class="sum-row" id="whoRow" hidden><span class="k">${esc(tr('booking.summary.patient'))}</span>
          <span class="v"><b id="whoName"></b>
            <button class="who-change" id="whoChange" type="button">${esc(tr('booking.change'))}</button></span></div>
        <div class="sum-row"><span class="k">${esc(tr('booking.summary.doctor'))}</span><span class="v">${esc(d.name)}</span></div>
        <div class="sum-row"><span class="k">${esc(tr('booking.summary.field'))}</span><span class="v">${esc(jobText(d))}</span></div>
        ${serviceRow}
        <div class="sum-row"><span class="k">${esc(tr('booking.summary.date'))}</span><span class="v">${state.dateLabel}</span></div>
        <div class="sum-row"><span class="k">${esc(tr('booking.summary.time'))}</span><span class="v">${state.time} · ${d.slotMinutes} ${esc(tr('booking.minutes'))}</span></div>
      </div>
      <p class="book-msg" id="bookMsg" role="status" aria-live="polite"></p>
      <button class="btn w-full" id="wBook">${esc(tr(payOnline ? 'booking.confirm.payButton' : 'booking.confirm.button'))}</button>
      <p class="pay-note">${esc(tr('booking.confirm.note'))}</p>
      <button class="back-link">${esc(tr('booking.back'))}</button>`;

    wBody.querySelector('.back-link').addEventListener('click', () => setStep(4));

    const msg = wBody.querySelector('#bookMsg');
    const btn = wBody.querySelector('#wBook');

    /*
      Administrator uchun sinov: onlayn to'lov yoqilganda ham har safar
      to'lamasdan bron qilib ko'rish. Tugma faqat adminga ko'rinadi, server
      esa ruxsatni o'zi qayta tekshiradi (`skipPayment` — faqat admin).
    */
    (async () => {
      if (!(await isAdminSession())) return;
      if (!btn.isConnected || wBody.querySelector('#skipPay')) return;
      btn.insertAdjacentHTML(
        'beforebegin',
        `<label class="admin-skip" style="display:flex;gap:8px;align-items:center;font-size:13px;margin:8px 0">
           <input type="checkbox" id="skipPay" /> ${esc(tr('booking.confirm.adminSkip'))}
         </label>`,
      );
      // Sinov bron Payme'ga o'tmaydi — belgilansa matn va tugma kassa rejimiga qaytadi.
      const skip = wBody.querySelector('#skipPay');
      skip.addEventListener('change', () => {
        const online = payOnline && !skip.checked;
        wBody.querySelector('.price-note').textContent = online ? onlineNote : payNote;
        btn.textContent = tr(online ? 'booking.confirm.payButton' : 'booking.confirm.button');
      });
    })();

    // 4-qadamda tanlangan bemor shu yerda ko'rinadi.
    const whoRow = wBody.querySelector('#whoRow');
    if (state.patientName) {
      whoRow.hidden = false;
      wBody.querySelector('#whoName').textContent = state.patientName;
      wBody.querySelector('#whoChange').addEventListener('click', () => setStep(4));
    }

    btn.addEventListener('click', async () => {
      btn.disabled = true;
      msg.textContent = tr('booking.confirm.working');
      msg.className = 'book-msg';

      try {
        const res = await fetch('/api/book', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            doctor: d.id,
            date: state.date,
            time: state.time,
            ...(state.patientId ? { patientId: state.patientId } : {}),
            ...(svc.main ? {} : { serviceId: svc.id }),
            privacyAccepted: state.privacyAccepted,
            ...(wBody.querySelector('#skipPay')?.checked ? { skipPayment: true } : {}),
          }),
        });
        const data = await res.json();

        if (res.status === 401) {
          // Sessiya tugagan — 4-qadamda kirish oynasi ochiladi, tanlovlar saqlanadi.
          patients = null;
          state.patientId = null;
          setStep(4);
          return;
        }

        if (res.status === 409) {
          msg.textContent = data.error ?? tr('booking.taken');
          msg.className = 'book-msg error';
          btn.disabled = false;
          setTimeout(() => {
            state.time = null;
            setStep(3);
          }, 1600);
          return;
        }

        if (!res.ok) {
          msg.textContent = data.error ?? tr('booking.failed');
          msg.className = 'book-msg error';
          btn.disabled = false;
          return;
        }

        if (data.redirectUrl) {
          window.location.href = data.redirectUrl;
          return;
        }

        state.booked = data;
        render();
      } catch {
        msg.textContent = tr('common.error.network');
        msg.className = 'book-msg error';
        btn.disabled = false;
      }
    });
  }

  render();

  /*
    Jonli shifokor ro'yxati. Statik ro'yxat bilan darhol chizamiz,
    keyin serverdagi ro'yxatga almashamiz — bosqich 1/2 da bo'lsak,
    yangilangan ro'yxat qayta chiziladi.
  */
  (async () => {
    try {
      const res = await fetch('/api/doctors');
      if (!res.ok) return;
      applyPayMode(res.headers.get('x-payment-mode') === 'online' ? 'online' : 'at_clinic');
      const live = await res.json();
      if (Array.isArray(live) && live.length) {
        docs = live;
        if (state.step <= 2) render();
        /*
          Sahifadagi statik sonlar ham jonli ro'yxatga tenglashadi —
          faolsiz shifokor "9 shifokor" hisobida turmasin.
        */
        const stat = document.getElementById('statDoctors');
        if (stat) stat.textContent = String(docs.length);

        /*
          Ishdan bo'shagan shifokor bazada saqlanadi (navbatlar tarixi
          uchun), lekin "faolsiz" bo'lgani uchun bemorga ko'rinmasligi
          kerak — kartasi olib tashlanadi.
        */
        const liveIds = new Set(docs.map((d) => d.id));
        document.querySelectorAll('[data-doc-card]').forEach((card) => {
          card.hidden = !liveIds.has(card.dataset.docCard);
        });

        // Yosh cheklovi (admin panelda o'zgarsa) kartada ham yangilanadi.
        docs.forEach((d) => {
          const chip = document.querySelector(`[data-doc-card="${d.id}"] [data-doc-age]`);
          if (!chip) return;
          const text = ageChip(toAgeGroup(d.ageGroup), lang);
          chip.hidden = !text;
          chip.textContent = text;
        });

        // Yosh cheklovi (admin panelda o'zgarsa) kartada ham yangilanadi.
        docs.forEach((d) => {
          const chip = document.querySelector(`[data-doc-card="${d.id}"] [data-doc-age]`);
          if (!chip) return;
          const text = ageChip(toAgeGroup(d.ageGroup), lang);
          chip.hidden = !text;
          chip.textContent = text;
        });

        // Bemor baholari (G2): o'rtacha va soni shifokor kartasida.
        docs.forEach((d) => {
          const chip = document.querySelector(`[data-doc-card="${d.id}"] [data-doc-rating]`);
          if (!chip) return;
          chip.hidden = !d.ratingCount;
          if (d.ratingCount) chip.textContent = tr('doctor.rating', { avg: d.ratingAvg, n: d.ratingCount });
        });

        // Shifokori qolmagan bo'lim: son o'rniga izoh, tugma o'chiq.
        document.querySelectorAll('[data-dept-cnt]').forEach((el) => {
          const n = docs.filter((d) => d.deptId === el.dataset.deptCnt).length;
          el.textContent = n ? `${n} shifokor` : 'vaqtincha yopiq';
          el.classList.toggle('none', n === 0);
        });
        document.querySelectorAll('[data-dept-card]').forEach((card) => {
          const n = docs.filter((d) => d.deptId === card.dataset.deptCard).length;
          const go = card.querySelector('.go');
          if (go) {
            go.disabled = n === 0;
            go.title = n === 0 ? tr('booking.dept.empty') : '';
          }
        });
      }
    } catch {
      /* server yetib bo'lmasa — statik ro'yxat qoladi */
    }
  })();

  /*
    Bo'lim/shifokor kartalaridagi "Navbat olish" tugmalari. Kartalar
    sahifada ko'p va qayta chizilishi mumkin — delegatsiya ishlatiladi.
  */
  document.addEventListener('click', (e) => {
    const b = e.target.closest('[data-book-dept]');
    if (!b) return;
    state.deptId = b.dataset.bookDept;
    state.booked = null;
    state.serviceId = 'main';
    state.time = null;
    state.date = null;
    // Shifokor jonli ro'yxatdan o'chirilgan bo'lishi mumkin — o'shanda
    // bo'lim ro'yxatiga tushamiz, aks holda to'g'ridan vaqt tanlashga.
    const doc = b.dataset.bookDoc ? docById(b.dataset.bookDoc) : null;
    if (doc) {
      state.doc = doc;
      setStep(3);
    } else {
      state.doc = null;
      setStep(2);
    }
    document.getElementById('navbat-widget').scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>

