---
import Logo from './Logo.astro';
import { LANGS, type Lang } from '../data/i18n';
import { h, langHref, LANG_LABEL } from '../data/home';

interface Props {
  /** Ommaviy sahifada — o'sha sahifaning tili; kabinetda berilmaydi. */
  lang?: Lang;
}
const { lang } = Astro.props;
const L: Lang = lang ?? 'uz';

/*
  Havolalar tanlangan tilga bog'lanadi: `/ru/` da turgan odam menyudagi
  «Анализы» ni bosganda `/ru/tahlillar` ga tushadi, o'zbekchasiga emas.
*/
const links = [
  { href: `${langHref('/', L)}#bolimlar`, key: 'nav.depts', label: h('nav.depts', L) },
  { href: `${langHref('/', L)}#shifokorlar`, key: 'nav.doctors', label: h('nav.doctors', L) },
  { href: `${langHref('/', L)}#qanday`, key: 'nav.how', label: h('nav.how', L) },
  { href: langHref('/tahlillar', L), key: 'nav.analyses', label: h('nav.analyses', L) },
  { href: `${langHref('/', L)}#kontakt`, key: 'nav.contact', label: h('nav.contact', L) },
] as const;
const bookHref = `${langHref('/', L)}#navbat-widget`;

/*
  Til tugmalari — faqat ommaviy sahifada. Kabinetda til brauzerda
  almashadi (Sozlamalar bo'limida), sahifa qayta yuklanmaydi.
*/
const bare = Astro.url.pathname.replace(/^\/(ru|en)(?=\/|$)/, '') || '/';
const langLinks = lang ? LANGS.map((code) => ({ code, href: langHref(bare, code) })) : [];
---

<!--
  Header ikki qatlamli: tashqi `.nav-bar` butun kenglikda yopishqoq turadi
  va orqasidagi kontentni yopadigan fon beradi; ichidagi `.nav-in` esa
  odatdagi shisha kartochka. Avval faqat kartochka bor edi — uning
  atrofidagi 12px bo'shliqdan sarlavhalar ko'rinib qolardi.
-->
<header class="nav-bar" id="siteHeader" data-nav-lang={lang ?? ''}>
  <nav class="nav wrap" aria-label="Asosiy navigatsiya">
    <div class="nav-in glass">
      <a class="nav-logo" href={langHref('/', L)} aria-label="Dimed">
        <Logo height={26} label="Dimed logotipi" />
      </a>
      <div class="nav-links">
        {links.map((l) => <a href={l.href} data-t={l.key}>{l.label}</a>)}
      </div>
      <div class="nav-cta">
        <!-- Kirgan foydalanuvchida JS bu tugmani ism/avatar bilan menyu tugmasiga almashtiradi (C1) -->
        {
          langLinks.length > 0 && (
            <div class="lang-pick" role="group" aria-label={h('nav.lang', L)}>
              {langLinks.map((l) => (
                <a
                  class:list={['lang-btn', { on: l.code === L }]}
                  href={l.href}
                  hreflang={l.code}
                  aria-current={l.code === L ? 'true' : undefined}
                >
                  {LANG_LABEL[l.code]}
                </a>
              ))}
            </div>
          )
        }
        <a class="btn btn-ghost btn-sm nav-kabinet" id="navKabinet" href="/kabinet" data-t="nav.cabinet">{h('nav.cabinet', L)}</a>
        <a class="btn btn-sm nav-book" href={bookHref} data-t="nav.book">{h('nav.book', L)}</a>
        <button
          class="burger"
          id="navBurger"
          type="button"
          aria-label="Menyuni ochish"
          aria-expanded="false"
          aria-controls="navMenu"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>

    <!-- Mobil menyu: burger ostida ochiladi. Kabinet tugmasi bu yerga kirmaydi — u headerda doim ko'rinadi. -->
    <div class="nav-menu glass" id="navMenu" hidden>
      {
        langLinks.length > 0 && (
          <div class="lang-pick menu-lang" role="group" aria-label={h('nav.lang', L)}>
            {langLinks.map((l) => (
              <a class:list={['lang-btn', { on: l.code === L }]} href={l.href} hreflang={l.code}>
                {LANG_LABEL[l.code]}
              </a>
            ))}
          </div>
        )
      }
      {links.map((l) => <a class="nav-menu-link" href={l.href} data-t={l.key}>{l.label}</a>)}
      <a class="btn nav-menu-book" href={bookHref} data-t="nav.book">{h('nav.book', L)}</a>
    </div>

    <!-- Kabinet menyusi (kirgan foydalanuvchi): ism, telefon va bo'limlar -->
    <div class="acct-menu glass" id="acctMenu" hidden></div>
  </nav>
</header>

<script>
  import { t, isLang } from '../data/i18n';
  import { getLang, setLang, applyPageLang } from '../lib/lang';

  const header = document.getElementById('siteHeader');

  /*
    Ommaviy sahifada matn serverda o'sha tilda yozilgan — tegilmaydi.
    Kabinet va kirish sahifalarida esa til faqat brauzerda ma'lum
    (`?lang=`, manzil prefiksi yoki Sozlamalardagi tanlov), shuning
    uchun sarlavha matni shu yerda almashtiriladi.
  */
  if (header && !header.dataset.navLang) applyPageLang(getLang(), header);
  const burger = document.getElementById('navBurger') as HTMLButtonElement | null;
  const menu = document.getElementById('navMenu');
  const acctMenu = document.getElementById('acctMenu');
  const kabinet = document.getElementById('navKabinet') as HTMLAnchorElement | null;

  /* ---------- burger (mobil havolalar) ---------- */
  const setMenuOpen = (open: boolean) => {
    if (!menu || !burger || !header) return;
    menu.hidden = !open;
    header.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Menyuni yopish' : 'Menyuni ochish');
    if (open) setAcctOpen(false);
  };

  /* ---------- kabinet menyusi (C1) ---------- */
  let acctBtn: HTMLButtonElement | null = null;

  const setAcctOpen = (open: boolean) => {
    if (!acctMenu || !acctBtn) return;
    acctMenu.hidden = !open;
    acctBtn.setAttribute('aria-expanded', String(open));
    if (open) setMenuOpen(false);
  };

  if (header && burger && menu) {
    burger.addEventListener('click', () => setMenuOpen(menu.hidden));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setMenuOpen(false);
    });
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!menu.hidden && !header.contains(target)) setMenuOpen(false);
      if (acctMenu && !acctMenu.hidden && !header.contains(target)) setAcctOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!menu.hidden) {
        setMenuOpen(false);
        burger.focus();
      }
      if (acctMenu && !acctMenu.hidden) {
        setAcctOpen(false);
        acctBtn?.focus();
      }
    });
    // Desktop kenglikka o'tilsa ochiq menyu qolib ketmasin.
    window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
      if (e.matches) setMenuOpen(false);
    });
  }

  type SessionInfo = {
    role: 'guest' | 'patient' | 'doctor' | 'admin';
    admin?: boolean;
    doctor?: { id: string; name: string; job: string } | null;
    phone?: string;
    name?: string;
    lang?: string;
    /** Til Sozlamalarda tanlanganmi; yo'q bo'lsa `lang` — shunchaki standart. */
    langSaved?: boolean;
  };

  /*
    Sessiya cookie'si HttpOnly — kim kirganini faqat /api/session aytadi.
    Har sahifada so'ramaslik uchun javob 5 daqiqa sessionStorage'da
    turadi; kirish va chiqish uni tozalaydi.
  */
  const CACHE_KEY = 'dimed_session';
  const CACHE_TTL = 5 * 60_000;

  async function loadSession(): Promise<SessionInfo | null> {
    try {
      const raw = sessionStorage.getItem(CACHE_KEY);
      if (raw) {
        const cached = JSON.parse(raw) as { t: number; data: SessionInfo };
        if (Date.now() - cached.t < CACHE_TTL) return cached.data;
      }
    } catch {
      /* xotira yopiq — har safar so'raymiz */
    }
    try {
      const res = await fetch('/api/session', { credentials: 'same-origin' });
      if (!res.ok) return null;
      const data = (await res.json()) as SessionInfo;
      try {
        sessionStorage.setItem(CACHE_KEY, JSON.stringify({ t: Date.now(), data }));
      } catch {
        /* saqlanmasa ham ishlaydi */
      }
      return data;
    } catch {
      return null;
    }
  }

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c);

  /** "Yoʻldoshev Anvar Baxtiyorovich" → ism "Anvar", bosh harflar "YA". */
  const nameParts = (name: string) => {
    const words = name.trim().split(/\s+/).filter(Boolean);
    const first = words.length >= 2 ? words[1] : words[0];
    const initials = words
      .slice(0, 2)
      .map((w) => w[0]?.toUpperCase() ?? '')
      .join('');
    return { first: first ?? '', initials };
  };

  function renderAccount(info: SessionInfo) {
    if (!kabinet || !acctMenu) return;
    const lang = getLang();
    const tr = (key: Parameters<typeof t>[0]) => t(key, lang);
    const { first, initials } = nameParts(info.name ?? '');
    const label = first || info.phone || 'Kabinet';
    const avatar = initials || '•';

    // "Kabinet" havolasi o'rniga menyu tugmasi.
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'btn btn-ghost btn-sm acct-btn';
    btn.setAttribute('aria-haspopup', 'menu');
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-controls', 'acctMenu');
    btn.innerHTML = `<span class="av" aria-hidden="true">${esc(avatar)}</span><span class="acct-name">${esc(label)}</span>`;
    kabinet.replaceWith(btn);
    acctBtn = btn;

    const link = (href: string, text: string) => `<a class="acct-link" href="${href}" role="menuitem">${esc(text)}</a>`;
    const sections: string[] = [];

    sections.push(
      `<div class="acct-sec" role="none">
        ${link('/kabinet/navbatlar', tr('cabinet.menu.appointments'))}
        ${link('/kabinet/tahlillar', tr('cabinet.menu.results'))}
        ${link('/#navbat-widget', tr('cabinet.menu.book'))}
        ${link('/kabinet/sozlamalar', tr('cabinet.menu.settings'))}
      </div>`,
    );
    if (info.doctor) {
      sections.push(
        `<div class="acct-sec" role="none"><div class="acct-lab">Shifokor kabineti · ${esc(info.doctor.name)}</div>
          ${link('/kabinet/shifokor', tr('cabinet.menu.today'))}
          ${link('/kabinet/shifokor/jadval', tr('cabinet.menu.schedule'))}
          ${link('/kabinet/shifokor/dam', tr('cabinet.menu.dayOff'))}
          ${link('/kabinet/shifokor/sozlamalar', tr('cabinet.menu.settings'))}
        </div>`,
      );
    }
    if (info.admin) {
      sections.push(
        `<div class="acct-sec" role="none"><div class="acct-lab">Administrator</div>
          ${link('/kabinet/admin', tr('cabinet.menu.doctors'))}
          ${link('/kabinet/admin/narxlar', tr('cabinet.menu.prices'))}
          ${link('/kabinet/admin/baholar', tr('cabinet.menu.ratings'))}
        </div>`,
      );
    }

    acctMenu.setAttribute('role', 'menu');
    acctMenu.innerHTML = `<div class="acct-head">
        <span class="av big" aria-hidden="true">${esc(avatar)}</span>
        <div class="acct-who"><b>${esc(info.name || info.phone || '')}</b><small>${esc(info.phone ?? '')}</small></div>
      </div>
      ${sections.join('')}
      <button class="acct-out" id="acctLogout" type="button" role="menuitem">${esc(tr('cabinet.menu.logout'))}</button>`;

    btn.addEventListener('click', () => setAcctOpen(acctMenu.hidden));
    acctMenu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setAcctOpen(false);
    });
    document.getElementById('acctLogout')?.addEventListener('click', async () => {
      await fetch('/api/logout', { method: 'POST', credentials: 'same-origin' }).catch(() => {});
      try {
        sessionStorage.removeItem(CACHE_KEY);
      } catch {
        /* bo'sh */
      }
      window.location.href = '/';
    });
  }

  /*
    Kirgan bemorning tili serverda saqlanadi (Sozlamalar → Til), brauzerda esa
    `dimed_lang` — ikkalasi farq qilishi mumkin (boshqa qurilma, eski `?lang=`).
    Avval header eski tilda qolib ketardi: Sozlamalarda "O'zbekcha" tanlangan,
    menyu esa inglizcha. Kabinetda tilni faqat Sozlamalar o'zgartiradi,
    shuning uchun serverniki ustun: til tenglashtiriladi va sahifa bir marta
    qayta yuklanadi — qolgan matnlar ham to'g'ri tilda chizilsin.
    Ommaviy sahifa (manzildagi til) va aniq `?lang=` tegilmaydi.
  */
  function syncLangWithAccount(info: SessionInfo): boolean {
    if (!header || header.dataset.navLang) return false;
    if (new URLSearchParams(location.search).has('lang')) return false;
    // Til hech qachon tanlanmagan bo'lsa serverda faqat standart uz bor — bemor
    // saytda ruscha/inglizcha tanlagan bo'lsa, uni o'zbekchaga qaytarib yubormaymiz.
    if (!info.langSaved || !isLang(info.lang) || info.lang === getLang()) return false;

    setLang(info.lang);
    // Xotira yopiq bo'lsa (maxfiy rejim) til saqlanmaydi — qayta yuklash cheksiz aylanib qolmasin.
    if (getLang() !== info.lang) return false;
    applyPageLang(info.lang, header);
    location.reload();
    return true;
  }

  loadSession().then((info) => {
    if (!info || info.role === 'guest') return;
    if (syncLangWithAccount(info)) return;
    renderAccount(info);
  });
</script>

<style>
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Orqadagi kontent ko'rinmasin: sahifa foniga yaqin, biroz shaffof + blur. */
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
  }

  .nav {
    position: relative;
    padding: var(--sp-2) var(--wrap-pad);
  }

  .nav-in {
    display: flex;
    align-items: center;
    gap: 24px;
    border-radius: 16px;
    padding: var(--sp-2) var(--sp-3);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 24px;
    margin-left: auto;
    font-size: 14.5px;
    font-weight: 500;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--ink);
  }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  /* Til tanlash — uchta qisqa tugma, sarlavhada kam joy egallaydi. */
  .lang-pick {
    display: flex;
    gap: 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 4px 8px;
    font-size: 12.5px;
    font-weight: 650;
    color: var(--muted);
    text-decoration: none;
    line-height: 1;
  }

  .lang-btn:hover {
    color: var(--ink);
  }

  .lang-btn.on {
    background: var(--rose);
    color: #fff;
  }

  .menu-lang {
    align-self: flex-start;
    margin: 4px 8px 8px;
  }

  .nav-links + .nav-cta {
    margin-left: 0;
  }

  /* --- kabinet tugmasi (kirgan foydalanuvchi) --- */
  .nav-cta :global(.acct-btn) {
    gap: 8px;
    padding-left: 8px;
    max-width: 180px;
  }

  .nav-cta :global(.acct-name) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav :global(.av) {
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--rose);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0.02em;
  }

  .nav :global(.av.big) {
    width: 40px;
    height: 40px;
    font-size: 15px;
  }

  .acct-menu {
    position: absolute;
    right: 24px;
    top: calc(100% - 4px);
    width: min(320px, calc(100% - 48px));
    border-radius: 16px;
    padding: 8px;
    background: color-mix(in srgb, var(--card-solid) 96%, transparent);
    z-index: 2;
  }

  .acct-menu[hidden] {
    display: none;
  }

  .acct-menu :global(.acct-head) {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 8px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 4px;
  }

  .acct-menu :global(.acct-who) {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .acct-menu :global(.acct-who b) {
    font-size: 14.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .acct-menu :global(.acct-who small) {
    font-size: 12.5px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .acct-menu :global(.acct-sec) {
    display: flex;
    flex-direction: column;
    padding: 4px 0;
  }

  .acct-menu :global(.acct-sec + .acct-sec) {
    border-top: 1px solid var(--line);
  }

  .acct-menu :global(.acct-lab) {
    padding: 8px 16px 4px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .acct-menu :global(.acct-link) {
    padding: 8px 16px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
    font-size: 14.5px;
  }

  .acct-menu :global(.acct-link:hover),
  .acct-menu :global(.acct-link:focus-visible) {
    background: var(--rose-soft);
    color: var(--rose);
    outline: none;
  }

  .acct-menu :global(.acct-out) {
    width: 100%;
    margin-top: 4px;
    padding: 8px 16px;
    border: 0;
    border-top: 1px solid var(--line);
    border-radius: 0 0 10px 10px;
    background: none;
    text-align: left;
    font-weight: 600;
    font-size: 14.5px;
    color: var(--muted);
  }

  .acct-menu :global(.acct-out:hover) {
    color: var(--rose);
  }

  /* --- burger --- */
  .burger {
    display: none;
    width: 40px;
    height: 36px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: transparent;
    padding: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .burger span {
    display: block;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition:
      transform 0.2s,
      opacity 0.2s;
  }

  .burger:focus-visible {
    outline: 2px solid var(--rose);
    outline-offset: 2px;
  }

  .open .burger span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .open .burger span:nth-child(2) {
    opacity: 0;
  }

  .open .burger span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .nav-menu {
    position: absolute;
    left: 24px;
    right: 24px;
    top: calc(100% - 4px);
    border-radius: 16px;
    padding: 8px;
    /* Shisha emas, deyarli yaxlit fon: ostidagi matn menyu orqali o'qilmasin. */
    background: color-mix(in srgb, var(--card-solid) 96%, transparent);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-menu[hidden] {
    display: none;
  }

  .nav-menu-link {
    padding: 16px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
    font-size: 15px;
  }

  .nav-menu-link:hover,
  .nav-menu-link:focus-visible {
    background: var(--rose-soft);
    color: var(--rose);
  }

  .nav-menu-book {
    margin: 8px 8px 4px;
  }

  @media (max-width: 900px) {
    .nav-links,
    .nav-book,
    .nav-cta .lang-pick {
      display: none;
    }

    .burger {
      display: flex;
    }
  }

  @media (max-width: 600px) {
    .nav {
      padding: var(--sp-2) var(--wrap-pad);
    }

    .nav-in {
      padding: var(--sp-2) var(--sp-3);
      gap: 16px;
    }

    .nav-menu,
    .acct-menu {
      left: 16px;
      right: 16px;
      width: auto;
    }

    .nav-cta :global(.acct-btn) {
      max-width: 140px;
    }
  }
</style>
