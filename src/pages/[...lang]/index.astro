---
import Base from '../../layouts/Base.astro';
import BookingWidget from '../../components/BookingWidget.astro';
import ClinicSchema from '../../components/ClinicSchema.astro';
import DeptIcon from '../../components/DeptIcon.astro';
import { departments, deptName, deptText } from '../../data/departments';
import { ageChip } from '../../lib/age';
import { activeDoctors, doctorsByDept, jobText, experienceText, hoursText } from '../../data/doctors';
import { site } from '../../data/site';
import { LANGS, type Lang } from '../../data/i18n';
import { h, langHref } from '../../data/home';
import { analysisTitle, analysisGroup, analysisDuration } from '../../data/analyses-i18n';
import analyses from '../../data/analyses.json';

/*
  Bitta fayl — uchta sahifa: `/`, `/ru/`, `/en/`. O'zbekcha ildizda
  turadi (asosiy til), qolganlari prefiks bilan. Shu sababli matn
  serverda yoziladi: Google ruscha sahifani ham indeksga oladi, JS
  ishga tushishini kutmaydi.
*/
export function getStaticPaths() {
  return LANGS.map((code) => ({ params: { lang: code === 'uz' ? undefined : code }, props: { lang: code } }));
}

const { lang } = Astro.props as { lang: Lang };

const featured = ['19', '57', '23', '29', '798', '693', '691'];
const featuredAnalyses = featured
  .map((code) => analyses.find((a) => a.code === code))
  .filter((a): a is (typeof analyses)[number] => Boolean(a));
---

<Base lang={lang} title={h('meta.title', lang)} description={h('meta.description', lang)}>
  <ClinicSchema lang={lang} slot="head" />
  <header class="hero wrap" id="navbat">
    <div class="hero-grid">
      <div>
        <div class="eyebrow">{h('hero.eyebrow', lang)}</div>
        <h1>{h('hero.title', lang)} <span class="grad">{h('hero.title.grad', lang)}</span></h1>
        <p class="hero-sub">{h('hero.sub', lang)}</p>
        <div class="hero-cta">
          <a class="btn" href="#navbat-widget">{h('hero.cta', lang)}</a>
          <a class="btn btn-ghost" href="#bolimlar">{h('hero.cta2', lang)}</a>
        </div>
        <div class="hero-stats">
          <div class="stat-chip"><b>{departments.length}</b> {h('hero.stat.depts', lang)}</div>
          <div class="stat-chip"><b class="g" id="statDoctors">{activeDoctors.length}</b> {h('hero.stat.doctors', lang)}</div>
          <div class="stat-chip"><b data-analyses-count>{analyses.length}</b> {h('hero.stat.analyses', lang)}</div>
          <div class="stat-chip"><b class="g">08:00–22:00</b> {h('hero.stat.daily', lang)}</div>
        </div>
      </div>
      <BookingWidget lang={lang} />
    </div>
  </header>

  <section class="wrap features">
    <div class="feat-grid">
      <div class="feat glass rv">
        <div class="ic rose">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6l2.1 2.1M5.6 18.4l2.1-2.1m8.6-8.6l2.1-2.1"></path>
            <circle cx="12" cy="12" r="3.2"></circle>
          </svg>
        </div>
        <h3>{h('feat.tech.title', lang)}</h3>
        <p>{h('feat.tech.text', lang)}</p>
      </div>
      <div class="feat glass rv">
        <div class="ic leaf">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 21v-2a4 4 0 0 1 4-4 4 4 0 0 1 4 4v2"></path>
            <circle cx="12" cy="9" r="3.4"></circle>
            <path d="M17.8 8.2l1.4-1.4M4.8 6.8l1.4 1.4"></path>
          </svg>
        </div>
        <h3>{h('feat.docs.title', lang)}</h3>
        <p>{h('feat.docs.text', lang)}</p>
      </div>
      <div class="feat glass rv">
        <div class="ic rose">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5"></circle>
            <path d="M12 7.5V12l3 2.5"></path>
          </svg>
        </div>
        <h3>{h('feat.queue.title', lang)}</h3>
        <p>{h('feat.queue.text', lang)}</p>
      </div>
    </div>
  </section>

  <section class="wrap" id="bolimlar">
    <div class="sec-head rv">
      <div class="eyebrow">{h('dept.eyebrow', lang)}</div>
      <h2>{departments.length} {h('dept.title', lang)}</h2>
      <p>{h('dept.text', lang)}</p>
    </div>
    <div class="dept-cards">
      {
        departments.map((d) => (
          <div class="dept-card glass rv" data-dept-card={d.id}>
            <div class="top">
              <div class="ic">
                <DeptIcon icon={d.icon} />
              </div>
              <span class="cnt" data-dept-cnt={d.id}>{doctorsByDept(d.id).length} {h('dept.count', lang)}</span>
            </div>
            <h3>{deptName(d, lang)}</h3>
            <p>{deptText(d, lang)}</p>
            <button class="go" data-book-dept={d.id}>
              {h('hero.cta', lang)}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </button>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap" id="shifokorlar">
    <div class="sec-head rv">
      <div class="eyebrow">{h('docs.eyebrow', lang)}</div>
      <h2>{h('docs.title', lang)}</h2>
      <p>{h('docs.text', lang)}</p>
    </div>
    <div class="doc-cards">
      {
        activeDoctors.map((d) => (
          <div class="doc-card glass rv" data-doc-card={d.id}>
            <div class="ph">
              <img src={d.photo} alt={d.name} width="64" height="64" loading="lazy" />
              <div>
                <h3>{d.name}</h3>
                <div class="jb">{jobText(d, lang)}</div>
              </div>
            </div>
            <div class="meta">
              {d.experience && (
                <span class="m-chip exp">
                  {experienceText(d.experience, lang)} {h('docs.experience', lang)}
                </span>
              )}
              <span class="m-chip">{hoursText(d.hours, lang)}</span>
              <span class="m-chip age" data-doc-age hidden={!ageChip(d.ageGroup ?? 'all')}>
                {ageChip(d.ageGroup ?? 'all')}
              </span>
              <span class="m-chip rating" data-doc-rating hidden></span>
            </div>
            <div class="foot">
              <span class="slotlen">
                {h('docs.slot', lang)} <b>{d.slotMinutes} {h('docs.minutes', lang)}</b>
              </span>
              <button class="btn btn-sm" data-book-dept={d.deptId} data-book-doc={d.id}>
                {h('hero.cta', lang)}
              </button>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap" id="qanday">
    <div class="sec-head rv">
      <div class="eyebrow">{h('how.eyebrow', lang)}</div>
      <h2>{h('how.title', lang)}</h2>
      <p>{h('how.text', lang)}</p>
    </div>
    <div class="how-grid">
      <div class="how-steps">
        <div class="how-step rv">
          <div class="how-num">1</div>
          <div>
            <h3>{h('how.1.title', lang)}</h3>
            <p>
              {h('how.1.text.a', lang)} <b>Dimed</b> {h('how.1.text.b', lang)}
            </p>
          </div>
        </div>
        <div class="how-step rv">
          <div class="how-num">2</div>
          <div>
            <h3>{h('how.2.title', lang)}</h3>
            <p>{h('how.2.text', lang)}</p>
          </div>
        </div>
        <div class="how-step rv">
          <div class="how-num">3</div>
          <div>
            <h3>{h('how.3.title', lang)}</h3>
            <p>{h('how.3.text', lang)}</p>
          </div>
        </div>
        <div class="how-step rv">
          <div class="how-num">4</div>
          <div>
            <h3>{h('how.4.title', lang)}</h3>
            <p>{h('how.4.text', lang)}</p>
            <span class="rule">{h('how.rule', lang)}</span>
          </div>
        </div>
      </div>
      <div class="phone glass rv" aria-label={h('how.phone.alt', lang)}>
        <div class="phone-top">
          <div class="av">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M21.9 4.1c.3-1.2-.9-2.2-2-1.7L2.7 9.2c-1.2.5-1.1 2.2.1 2.6l4.4 1.4 1.7 5.3c.4 1.1 1.8 1.4 2.6.5l2.4-2.5 4.6 3.4c1 .7 2.4.2 2.6-1L21.9 4.1z"
              ></path></svg
            >
          </div>
          <div>
            <div class="nm">Dimed Klinika Bot</div>
            <div class="st">{h('how.phone.online', lang)}</div>
          </div>
        </div>
        <div class="chat">
          <div class="bub usr">/start<span class="t">08:41</span></div>
          <div class="bub bot">
            {h('how.chat.hello', lang)}<span class="t">08:41</span>
          </div>
          <div class="bub bot">
            {h('how.chat.code', lang)}<span class="otp">4 8 2 9 1 7</span>{h('how.chat.code.note', lang)}<span
              class="t">08:42</span
            >
          </div>
          <div class="bub bot">
            {h('how.chat.booked', lang)}<br />{h('how.chat.doctor', lang)}<br />{h('how.chat.when', lang)}<span
              class="t">08:47</span
            >
          </div>
          <div class="bub bot">{h('how.chat.remind', lang)}<span class="t">08:15</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap" id="klinika">
    <div class="sec-head rv">
      <div class="eyebrow">{h('gallery.eyebrow', lang)}</div>
      <h2>{h('gallery.title', lang)}</h2>
      <p>{h('gallery.text', lang)}</p>
    </div>
    <div class="gallery">
      <figure class="shot big rv">
        <img
          src="/images/klinika-bino.webp"
          alt={h('gallery.building', lang)}
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{h('gallery.building', lang)}</figcaption>
      </figure>
      <figure class="shot rv">
        <img
          src="/images/klinika-xona.webp"
          alt={h('gallery.room', lang)}
          width="1200"
          height="901"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{h('gallery.room', lang)}</figcaption>
      </figure>
      <figure class="shot rv">
        <img
          src="/images/klinika-laboratoriya.webp"
          alt={h('gallery.lab', lang)}
          width="1200"
          height="558"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{h('gallery.lab', lang)}</figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap" id="tahlillar-preview">
    <div class="sec-head rv">
      <div class="eyebrow">{h('lab.eyebrow', lang)}</div>
      <h2>{h('lab.title', lang)}</h2>
      <p>{h('lab.text', lang)}</p>
    </div>
    <div class="table-wrap glass rv">
      <table>
        <thead>
          <tr>
            <th>{h('lab.col.name', lang)}</th>
            <th>{h('lab.col.group', lang)}</th>
            <th>{h('lab.col.ready', lang)}</th>
            <th>{h('lab.col.price', lang)}</th>
          </tr>
        </thead>
        <tbody>
          {
            featuredAnalyses.map((a) => (
              <tr data-analysis-row>
                <td>{analysisTitle(a.code, a.title, lang)}</td>
                <td>
                  <span class="g-chip">{analysisGroup(a.group, lang)}</span>
                </td>
                <td class="dur">{analysisDuration(a.duration, lang)}</td>
                <td class="price" data-price-code={a.code}>{a.price} {h('lab.sum', lang)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="tbl-note rv">
      <a class="btn btn-ghost btn-sm" href={langHref('/tahlillar', lang)}>
        {h('lab.all.a', lang)} <span data-analyses-count>{analyses.length}</span> {h('lab.all.b', lang)}
      </a>
      <span>{h('lab.note', lang)}</span>
    </div>
  </section>

  <section class="wrap" id="kontakt">
    <div class="contact-grid">
      <div class="contact-card glass rv">
        <div class="sec-head contact-head">
          <div class="eyebrow">{h('contact.eyebrow', lang)}</div>
          <h2>{h('contact.title', lang)}</h2>
        </div>
        <div class="c-row">
          <div class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21s-7-5.6-7-11a7 7 0 0 1 14 0c0 5.4-7 11-7 11z"></path>
              <circle cx="12" cy="10" r="2.6"></circle>
            </svg>
          </div>
          <div>
            <div class="k">{h('contact.address', lang)}</div>
            <div class="v">
              <a class="plain map-link" href={site.mapsUrl} target="_blank" rel="noopener">
                {h('contact.address.value', lang)}
              </a>
              <small>{h('contact.address.note', lang)}</small>
            </div>
          </div>
        </div>
        <div class="c-row">
          <div class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path>
            </svg>
          </div>
          <div>
            <div class="k">{h('contact.phone', lang)}</div>
            <div class="v"><a class="plain" href={site.phoneHref}>{site.phone}</a></div>
          </div>
        </div>
        <div class="c-row">
          <div class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5"></circle>
              <path d="M12 7.5V12l3 2.5"></path>
            </svg>
          </div>
          <div>
            <div class="k">{h('contact.hours', lang)}</div>
            <div class="v">
              {h('contact.hours.value', lang)}<small>{h('contact.hours.note', lang)}</small>
            </div>
          </div>
        </div>
      </div>
      <div class="cta-card rv">
        <h3>{h('contact.cta.title', lang)}</h3>
        <p>{h('contact.cta.text', lang)}</p>
        <a class="btn" href={site.telegramBot} target="_blank" rel="noopener">
          {h('contact.cta.btn', lang)}
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Tahlil narxlari bazadan (admin panel) yangilanadi (F2).
  import { applyLivePrices } from '../../lib/live-prices';
  applyLivePrices();
</script>

<style>

  /* Klinika suratlari: katta bino chapda, ikki kichigi o'ngda ustma-ust. */
  .gallery {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    grid-template-rows: repeat(2, 1fr);
    gap: 16px;
  }

  .shot {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--card-brd);
    background: var(--chip-bg);
  }

  .shot.big {
    grid-row: span 2;
  }

  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24px 16px 8px;
    font-size: 12.5px;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(to top, rgb(0 0 0 / 0.62), transparent);
  }

  @media (max-width: 760px) {
    .gallery {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .shot.big {
      grid-row: auto;
    }

    .shot img {
      /* Telefonda rasmlar kamroq o'rin egallasin — ko'z asosiy maqsadga
         tez yetsin, galereya sahifani egallab yubormasin. */
      aspect-ratio: 16 / 10;
    }
  }
  section {
    padding: var(--section-pad) 0;
  }

  .features {
    padding-top: var(--sp-4);
  }

  .hero {
    padding: var(--section-pad) 0 var(--sp-6);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .hero h1 {
    font-size: clamp(34px, 4.6vw, 56px);
    font-weight: 750;
  }

  .grad {
    background: linear-gradient(92deg, var(--rose) 10%, var(--leaf) 95%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-sub {
    margin-top: 24px;
    font-size: 17px;
    color: var(--muted);
    max-width: 54ch;
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .hero-stats {
    display: flex;
    gap: 8px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .stat-chip {
    background: var(--chip-bg);
    backdrop-filter: blur(18px) saturate(1.5);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    border: 1px solid var(--card-brd);
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13.5px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .stat-chip b {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 800;
    color: var(--rose);
  }

  .stat-chip .g {
    color: var(--leaf);
  }

  /* features */
  .feat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 820px) {
    .feat-grid {
      grid-template-columns: 1fr;
    }
  }

  .feat {
    border-radius: 18px;
    padding: var(--card-pad);
  }

  .feat .ic {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .feat .ic svg {
    width: 22px;
    height: 22px;
  }

  .feat .ic.rose {
    background: var(--rose-soft);
    color: var(--rose);
  }

  .feat .ic.leaf {
    background: var(--leaf-soft);
    color: var(--leaf);
  }

  .feat h3 {
    font-size: 17.5px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .feat p {
    font-size: 14px;
    color: var(--muted);
  }

  /* departments */
  .dept-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 900px) {
    .dept-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .dept-cards {
      grid-template-columns: 1fr;
    }
  }

  .dept-card {
    border-radius: 18px;
    padding: var(--card-pad);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 0.18s;
  }

  .dept-card:hover {
    transform: translateY(-3px);
  }

  .dept-card .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dept-card .ic {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--rose-soft);
    color: var(--rose);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dept-card .ic :global(svg) {
    width: 21px;
    height: 21px;
  }

  .dept-card:nth-child(even) .ic {
    background: var(--leaf-soft);
    color: var(--leaf);
  }

  .dept-card .cnt {
    font-size: 11.5px;
    font-weight: 650;
    color: var(--muted);
    background: var(--chip-bg);
    border: 1px solid var(--card-brd);
    border-radius: 999px;
    padding: 4px 8px;
  }

  .dept-card h3 {
    font-size: 17px;
    font-weight: 700;
  }

  .dept-card p {
    font-size: 13.5px;
    color: var(--muted);
    flex: 1;
  }

  .dept-card .go {
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    font-size: 13px;
    font-weight: 650;
    color: var(--rose);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dept-card .go:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* doctors */
  .doc-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 900px) {
    .doc-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .doc-cards {
      grid-template-columns: 1fr;
    }
  }

  .doc-card {
    border-radius: 18px;
    padding: var(--card-pad);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .doc-card .ph {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .doc-card .ph img {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    object-fit: cover;
    background: var(--rose-soft);
  }

  .doc-card h3 {
    font-size: 15.5px;
    font-weight: 700;
