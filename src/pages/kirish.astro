---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { t } from '../data/i18n';

/*
  Kirish sahifasi bitta manzilda turadi (robots.txt uni yopadi —
  indekslanmaydi), shuning uchun `/ru/kirish` yo'q. Matn serverda
  o'zbekcha yoziladi, brauzerda esa `applyPageLang` tanlangan tilga
  almashtiradi: bemor `?lang=ru` bilan yoki ruscha sahifadan kelgan
  bo'lishi mumkin.
*/
const uz = (key: Parameters<typeof t>[0]) => t(key, 'uz');
---

<Base
  title={uz('signin.page.title')}
  description={uz('signin.page.description')}
>
  <section class="wrap page">
    <div class="card glass">
      <div class="eyebrow" data-t="signin.page.eyebrow">{uz('signin.page.eyebrow')}</div>
      <h1 data-t="signin.page.heading">{uz('signin.page.heading')}</h1>
      <p class="lede" data-t="signin.page.lede">{uz('signin.page.lede')}</p>

      <ol class="steps">
        <li>
          <b data-t="signin.page.step1new">{uz('signin.page.step1new')}</b>
          <a class="btn tg getcode" id="getCode" href={site.telegramBot} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18"><path d="M21.9 4.3 18.6 19.6c-.24 1.1-.9 1.37-1.82.85l-5.03-3.7-2.43 2.33c-.27.27-.5.5-1 .5l.36-5.1L17.9 6.1c.4-.36-.09-.56-.62-.2L6.63 12.6l-4.98-1.56c-1.08-.34-1.1-1.08.23-1.6L20.5 2.72c.9-.34 1.68.2 1.4 1.58Z"/></svg>
            <span data-t="signin.page.getCode">{uz('signin.page.getCode')}</span>
          </a>
          <p class="hint" id="getStatus" role="status" aria-live="polite"></p>
        </li>
        <li>
          <b data-t="signin.page.enterCode">{uz('signin.page.enterCode')}</b>
          <label class="fld-inline">
            <span class="fld-lbl" data-t="signin.page.phoneLabel">{uz('signin.page.phoneLabel')}</span>
            <input
              id="phone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              placeholder="+998 90 123 45 67"
              aria-label={uz('signin.page.phoneLabel')}
            />
          </label>
          <div class="otp-row" id="otpRow">
            {
              [1, 2, 3, 4, 5, 6].map((n) => (
                <input
                  class="otp"
                  type="text"
                  inputmode="numeric"
                  maxlength="1"
                  aria-label={t('signin.page.digit', 'uz', { n })}
                />
              ))
            }
          </div>
        </li>
      </ol>

      <p class="msg" id="msg" role="status" aria-live="polite"></p>
      <button class="btn" id="submit" data-t="booking.login.button">{uz('booking.login.button')}</button>

      <p class="help">
        <span data-t="signin.page.help">{uz('signin.page.help')}</span><br />
        <span data-t="signin.page.questions">{uz('signin.page.questions')}</span>
        <a href={site.phoneHref}>{site.phone}</a>
      </p>
    </div>

    <!--
      Kirishdan keyingi qadam: bir telefondan butun oila foydalanadi
      (ota-ona bolasini o'z raqami bilan yozdiradi), shuning uchun
      kim kirayotganini bir marta so'raymiz.
    -->
    <div class="card glass" id="whoCard" hidden>
      <div class="eyebrow" data-t="signin.who.eyebrow">{uz('signin.who.eyebrow')}</div>
      <h1 id="whoTitle">{uz('signin.who.title')}</h1>
      <p class="lede" id="whoLede">{uz('signin.who.lede')}</p>

      <div class="who-list" id="whoList"></div>

      <button class="btn btn-ghost" id="whoNew" type="button" data-t="signin.who.other">{uz('signin.who.other')}</button>

      <div class="who-form" id="whoForm" hidden>
        <label class="fld">
          <span><span data-t="signin.who.lastName">{uz('signin.who.lastName')}</span><i>*</i></span>
          <input id="w-last" type="text" autocomplete="family-name" placeholder="Yoʻldoshev" />
        </label>
        <label class="fld">
          <span><span data-t="signin.who.firstName">{uz('signin.who.firstName')}</span><i>*</i></span>
          <input id="w-first" type="text" autocomplete="given-name" placeholder="Anvar" />
        </label>
        <label class="fld">
          <span data-t="signin.who.patronymic">{uz('signin.who.patronymic')}</span>
          <input id="w-mid" type="text" data-t-placeholder="signin.who.patronymicHint" placeholder={uz('signin.who.patronymicHint')} />
        </label>
        <div class="fld">
          <span><span data-t="booking.birthDate">{uz('booking.birthDate')}</span><i>*</i></span>
          <div id="w-birth"></div>
        </div>
        <div class="who-actions">
          <button class="btn btn-ghost btn-sm" id="whoCancel" type="button" data-t="signin.who.cancel">{uz('signin.who.cancel')}</button>
          <button class="btn btn-sm" id="whoSave" type="button" data-t="signin.who.save">{uz('signin.who.save')}</button>
        </div>
      </div>

      <p class="msg" id="whoMsg" role="status" aria-live="polite"></p>
    </div>
  </section>
</Base>

<script>
  import { parsePhone, formatPhone } from '../lib/phone';
  import { safeNext } from '../lib/safe-next';
  import { birthDateSelectsHtml, readBirthDate } from '../lib/birthdate';
  import { getLang, applyPageLang } from '../lib/lang';
  import { t } from '../data/i18n';

  const lang = getLang();
  const tr = (key: Parameters<typeof t>[0], vars?: Parameters<typeof t>[2]) => t(key, lang, vars);
  applyPageLang(lang);

  const phoneInput = document.getElementById('phone') as HTMLInputElement;
  const otpInputs = [...document.querySelectorAll<HTMLInputElement>('#otpRow .otp')];
  const submit = document.getElementById('submit') as HTMLButtonElement;
  const msg = document.getElementById('msg') as HTMLParagraphElement;

  const setMsg = (text: string, kind: 'error' | 'ok' | '' = '') => {
    msg.textContent = text;
    msg.className = `msg${kind ? ` ${kind}` : ''}`;
  };

  otpInputs.forEach((input, i) => {
    input.addEventListener('input', () => {
      input.value = input.value.replace(/\D/g, '').slice(0, 1);
      if (input.value && i < otpInputs.length - 1) otpInputs[i + 1]?.focus();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !input.value && i > 0) otpInputs[i - 1]?.focus();
      if (e.key === 'Enter') submit.click();
    });
    input.addEventListener('paste', (e) => {
      e.preventDefault();
      const digits = (e.clipboardData?.getData('text') ?? '').replace(/\D/g, '').slice(0, 6);
      digits.split('').forEach((c, j) => {
        const box = otpInputs[j];
        if (box) box.value = c;
      });
      if (digits.length === 6) submit.click();
    });
  });

  phoneInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') otpInputs[0]?.focus();
  });

  /*
    Raqam har xil yozilishi mumkin — bo'sh joy, chiziqcha, qavs,
    mamlakat kodi bilan yoki usiz. Hammasini qabul qilamiz, lekin
    noto'g'risini serverga yubormasdan aytamiz.
  */
  phoneInput.addEventListener('blur', () => {
    const checked = parsePhone(phoneInput.value);
    if (checked.ok) phoneInput.value = formatPhone(checked.value);
  });

  submit.addEventListener('click', async () => {
    const checked = parsePhone(phoneInput.value);
    const code = otpInputs.map((i) => i.value).join('');

    if (!checked.ok) {
      setMsg(checked.error, 'error');
      phoneInput.focus();
      return;
    }
    const phone = checked.value;
    if (code.length !== 6) {
      setMsg(tr('booking.login.codeRequired'), 'error');
      otpInputs.find((i) => !i.value)?.focus();
      return;
    }

    submit.disabled = true;
    setMsg(tr('booking.login.working'));

    try {
      const res = await fetch('/api/auth-verify', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ phone, code }),
      });
      const data = (await res.json()) as { error?: string };

      if (res.ok) {
        setMsg(tr('signin.page.welcome'), 'ok');
        await askWho();
        return;
      }

      setMsg(data.error ?? tr('booking.login.failed'), 'error');
      otpInputs.forEach((i) => (i.value = ''));
      otpInputs[0]?.focus();
    } catch {
      setMsg(tr('common.error.network'), 'error');
    } finally {
      submit.disabled = false;
    }
  });

  // ---------- "Kodni olish" (deep-link + poll) ----------
  /*
    Bir tugma: botga o'tadi va kod keladi. Bot /start kirish_<nonce> ni
    ko'rib telefonni kirish sessiyasiga yozadi (netlify auth-start,
    lib/login.ts); sayt esa nonce'ni poll qilib, raqamni oldindan
    to'ldiradi va kod maydonini fokuslaydi. Kod (OTP) baribir kiritiladi.
  */
  const getCode = document.getElementById('getCode') as HTMLAnchorElement;
  const getStatus = document.getElementById('getStatus') as HTMLParagraphElement;
  let pollTimer: ReturnType<typeof setInterval> | undefined;
  let pollUntil = 0;

  const setGetStatus = (text: string, kind: 'ok' | 'error' | '' = '') => {
    getStatus.textContent = text;
    getStatus.className = `hint${kind ? ` ${kind}` : ''}`;
  };

  const stopPolling = () => {
    if (pollTimer) clearInterval(pollTimer);
    pollTimer = undefined;
  };

  async function pollOnce(nonce: string): Promise<void> {
    if (Date.now() > pollUntil) {
      stopPolling();
      return;
    }
    try {
      const res = await fetch(`/api/auth-start?nonce=${encodeURIComponent(nonce)}`, {
        credentials: 'same-origin',
      });
      if (!res.ok) return;
      const data = (await res.json()) as { status: string; phone?: string | null };
      if (data.status === 'ready') {
        stopPolling();
        if (data.phone) phoneInput.value = formatPhone(data.phone);
        setGetStatus(tr('signin.page.codeSent'), 'ok');
        const label = getCode.querySelector('span');
        if (label) label.textContent = tr('signin.page.getCodeAgain');
        (phoneInput.value ? otpInputs[0] : phoneInput)?.focus();
      } else if (data.status === 'expired') {
        stopPolling();
        setGetStatus(tr('signin.page.expired'), 'error');
      }
    } catch {
      /* tarmoq — keyingi urinishda qayta so'raladi */
    }
  }

  getCode.addEventListener('click', async (e) => {
    /*
      Popup bloklovchisi ishga tushmasin: bo'sh oynani darhol (foydalanuvchi
      bosishi ichida) ochamiz, nonce olgach uni Telegramga yo'naltiramiz.
      Bloklansa — o'sha oynada (fallback: oddiy bot havolasi) ochiladi.
    */
    e.preventDefault();
    const tgWin = window.open('about:blank', '_blank');
    setGetStatus(tr('signin.page.opening'));

    let deepLink = getCode.href; // fallback: oddiy bot havolasi
    let nonce: string | null = null;
    try {
      const res = await fetch('/api/auth-start', { method: 'POST', credentials: 'same-origin' });
      if (res.ok) {
        const data = (await res.json()) as { nonce: string; deepLink: string };
        nonce = data.nonce;
        deepLink = data.deepLink;
      }
    } catch {
      /* auth-start ishlamasa — oddiy bot havolasi ochiladi */
    }

    if (tgWin) tgWin.location.href = deepLink;
    else window.location.href = deepLink;

    if (nonce) {
      setGetStatus(tr('signin.page.waiting'));
      stopPolling();
      pollUntil = Date.now() + 3.5 * 60 * 1000;
      const n = nonce;
      pollTimer = setInterval(() => void pollOnce(n), 2500);
    }
  });

  // ---------- "Kim kirmoqda?" ----------

  type Patient = { id: string; name: string; source: '1c' | 'local' };

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const go = (): void => {
    // Header'dagi "kim kirgan" keshi (C1) eskirmasin.
    try {
      sessionStorage.removeItem('dimed_session');
    } catch {
      /* bo'sh */
    }
    // Faqat shu saytdagi manzil — begona saytga yo'naltirish yo'q (lib/safe-next).
    window.location.href = safeNext(new URLSearchParams(location.search).get('next'), location.origin);
  };

  /**
   * Kirgandan keyin telefonga bog'langan bemorni tanlash.
   *
   * Bir marta so'raladi: tanlangani eslab qolinadi va keyingi
   * kirishlarda o'tkazib yuboriladi. Ro'yxat bo'sh bo'lsa —
   * darhol "yangi odam" formasi ochiladi (klinikada hali
   * ro'yxatdan o'tmagan bemor).
   */
  async function askWho(): Promise<void> {
    let data: { patients: Patient[]; activeId: string | null };
    try {
      const res = await fetch('/api/patients', { credentials: 'same-origin' });
      if (!res.ok) return go();
      data = await res.json();
    } catch {
      // Ro'yxatni olib bo'lmasa kirishni to'smaymiz.
      return go();
    }

    if (data.activeId) return go();
    if (data.patients.length === 1) {
      const only = data.patients[0];
      if (only) {
        await select(only.id);
        return;
      }
    }

    el('whoCard').hidden = false;
    el('whoCard').scrollIntoView({ behavior: 'smooth', block: 'center' });

    if (data.patients.length === 0) {
      el('whoTitle').textContent = tr('signin.who.introduce');
      el('whoLede').textContent =
        tr('signin.who.notFound');
      el('whoNew').hidden = true;
      el('whoForm').hidden = false;
      return;
    }

    el('whoList').innerHTML = data.patients
      .map(
        (p) =>
          `<button class="who-item" data-pick="${esc(p.id)}">
             <span class="who-nm">${esc(p.name)}</span>
             ${p.source === '1c' ? `<span class="who-tag">${tr('signin.who.inClinic')}</span>` : ''}
           </button>`,
      )
      .join('');

    el('whoList')
      .querySelectorAll<HTMLButtonElement>('[data-pick]')
      .forEach((b) => (b.onclick = () => select(b.dataset.pick ?? '')));
  }

  const esc = (t: string) =>
    t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c);

  const setWhoMsg = (text: string, kind: 'error' | '' = '') => {
    const box = el<HTMLParagraphElement>('whoMsg');
    box.textContent = text;
    box.className = `msg${kind ? ` ${kind}` : ''}`;
  };

  async function select(id: string): Promise<void> {
    setWhoMsg(tr('booking.saving'));
    try {
      const res = await fetch('/api/patients', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'select', id }),
      });
      if (!res.ok) throw new Error(String(res.status));
      go();
    } catch {
      setWhoMsg(tr('booking.saveFailed'), 'error');
    }
  }

  // Tug'ilgan sana — kun/oy/yil select'lari (brauzer kalendari emas).
  el('w-birth').innerHTML = birthDateSelectsHtml('new', lang);

  el('whoNew').addEventListener('click', () => {
    el('whoForm').hidden = false;
    el('whoNew').hidden = true;
    el<HTMLInputElement>('w-last').focus();
  });

  el('whoCancel').addEventListener('click', () => {
    el('whoForm').hidden = true;
    el('whoNew').hidden = false;
    setWhoMsg('');
  });

  el('whoSave').addEventListener('click', async () => {
    const lastName = el<HTMLInputElement>('w-last').value.trim();
    const firstName = el<HTMLInputElement>('w-first').value.trim();
    const patronymic = el<HTMLInputElement>('w-mid').value.trim();
    const birthDate = readBirthDate(el('whoForm'), 'new');

    if (!lastName || !firstName) {
      setWhoMsg(tr('booking.field.nameRequired'), 'error');
      return;
    }
    if (!birthDate) {
      setWhoMsg(tr('signin.who.birthRequired'), 'error');
      return;
    }

    setWhoMsg('Saqlanmoqda…');
    try {
      const res = await fetch('/api/patients', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'add', firstName, lastName, patronymic, birthDate }),
      });
      const body = (await res.json()) as { error?: string };
      if (!res.ok) {
        setWhoMsg(body.error ?? tr('booking.saveFailed'), 'error');
        return;
      }
      go();
    } catch {
      setWhoMsg(tr('common.error.network'), 'error');
    }
  });
</script>

<style>
  .page {
    padding: var(--section-pad) 0;
    display: flex;
    justify-content: center;
  }

  .card {
    border-radius: 22px;
    padding: var(--sp-5);
    max-width: 520px;
    width: 100%;
  }

  h1 {
    font-size: 28px;
    font-weight: 750;
  }

  .lede {
    color: var(--muted);
    font-size: 15px;
    margin-top: 8px;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    margin: 24px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .steps li {
    counter-increment: step;
    position: relative;
    padding-left: calc(28px + var(--sp-3));
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 28px;
    height: 28px;
    border-radius: 9px;
    background: var(--rose-soft);
    color: var(--rose);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .steps li b {
    display: block;
    font-size: 14.5px;
    font-weight: 650;
    margin-bottom: 8px;
  }

  .tg {
    background: var(--color-tg);
    box-shadow: 0 6px 20px -6px rgb(42 171 238 / 0.5);
  }

  /* "Kodni olish" — asosiy, ko'zga tashlanadigan tugma */
  .getcode {
    width: 100%;
    margin-top: 4px;
    font-size: 16px;
  }

  .hint {
    margin-top: 10px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    min-height: 18px;
    line-height: 1.45;
  }

  .hint.ok {
    color: var(--leaf);
  }

  .hint.error {
    color: var(--rose);
  }

  .fld-inline {
    display: block;
    margin-bottom: 12px;
  }

  .fld-lbl {
    display: block;
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 6px;
  }

  #phone {
    width: 100%;
    border: 1.5px solid var(--line);
    background: var(--chip-bg);
    color: var(--ink);
    border-radius: 12px;
    padding: 16px;
    font-size: 16px;
    font-variant-numeric: tabular-nums;
    font-family: inherit;
  }

  #phone:focus {
    border-color: var(--rose);
    outline: none;
  }

  .otp-row {
    display: flex;
    gap: 8px;
  }

  .otp {
    width: 100%;
    max-width: 52px;
    height: 56px;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    border: 1.5px solid var(--line);
    border-radius: 12px;
    background: var(--chip-bg);
    color: var(--ink);
  }

  .otp:focus {
    border-color: var(--rose);
    outline: none;
  }

  .msg {
    min-height: 22px;
    margin: 24px 0 16px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--muted);
  }

  .msg.error {
    color: var(--rose);
  }

  .msg.ok {
    color: var(--leaf);
  }

  #submit {
    width: 100%;
  }

  .help {
    margin-top: 16px;
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.6;
  }

  .help code {
    background: var(--chip-bg);
    border: 1px solid var(--card-brd);
    border-radius: 6px;
    padding: 1px 8px;
    font-size: 12px;
  }

  .help a {
    color: var(--rose);
    font-weight: 650;
    white-space: nowrap;
  }

  /* "Kim kirmoqda?" — kirishdan keyingi tanlov */
  .who-list {
    display: grid;
    gap: 8px;
    margin: 16px 0;
  }

  .who-list :global(.who-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }

  .who-list :global(.who-item:hover),
  .who-list :global(.who-item:focus-visible) {
    border-color: var(--leaf);
    background: color-mix(in srgb, var(--leaf) 6%, var(--card));
  }

  .who-list :global(.who-nm) {
    font-weight: 650;
    font-size: 15px;
  }

  .who-list :global(.who-tag) {
    flex: none;
    font-size: 11.5px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 8px;
  }

  .who-form {
    display: grid;
    gap: 8px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .who-form .fld {
    display: grid;
    gap: 4px;
  }

  .who-form .fld span {
    font-size: 12.5px;
    color: var(--muted);
  }

  .who-form .fld i {
    color: var(--leaf);
    font-style: normal;
  }

  .who-form input {
    width: 100%;
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: 11px;
    background: var(--bg);
    color: inherit;
    font: inherit;
  }

  .who-form input:focus-visible {
    outline: none;
    border-color: var(--leaf);
  }

  /* Tug'ilgan sana select'lari (JS chizadi — :global) */
  .who-form :global(.birth-row) {
    display: grid;
    grid-template-columns: 1fr 1.6fr 1.2fr;
    gap: 8px;
  }

  .who-form :global(.birth-sel) {
    width: 100%;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 11px;
    background: var(--bg);
