---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

/*
  /admin — klinika boshqaruv paneli (parol bilan).

  Parol Netlify muhit o'zgaruvchisida (ADMIN_PASSWORD); sahifa o'zi statik,
  hamma ma'lumot /api/admin-* orqali, imzolangan HttpOnly cookie bilan.
  Bo'limlar:
    1. Tashrif shifokorlari — qo'shish, tahrirlash, yashirish, o'chirish (uch tilda)
    2. Yozilganlar — kun bo'yicha, holat (keldi / kelmadi / bekor), telefon
    3. Rasmlar — banner, galereya, shifokor rasmlari (kod o'zgartirmasdan)

  Telegram orqali kiriladigan /kabinet/admin alohida va o'zgarmagan.
*/
const weekdays = [
  { n: 1, label: 'Du' },
  { n: 2, label: 'Se' },
  { n: 3, label: 'Chor' },
  { n: 4, label: 'Pay' },
  { n: 5, label: 'Ju' },
  { n: 6, label: 'Sh' },
  { n: 0, label: 'Yak' },
];
const slotOptions = [10, 15, 20, 30, 40, 45, 60, 90];
const langs = [
  { code: 'uz', label: 'Oʻzbekcha' },
  { code: 'ru', label: 'Русский' },
  { code: 'en', label: 'English' },
];
---

<!doctype html>
<html lang="uz">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin panel — Dimed</title>
    <link rel="icon" href="/favicon-32x32.svg" type="image/svg+xml" />
  </head>
  <body class="adm">
    <!-- ============ Kirish ============ -->
    <main class="adm-login" id="loginView" hidden>
      <form class="adm-login-card glass" id="loginForm" novalidate>
        <Logo height={28} label="Dimed" />
        <h1>Admin panel</h1>
        <p class="adm-muted">Davom etish uchun parolni kiriting.</p>
        <label class="adm-fld">
          <span>Parol</span>
          <input id="loginPass" type="password" autocomplete="current-password" required />
        </label>
        <p class="adm-msg" id="loginMsg" role="alert"></p>
        <button class="btn adm-wide" type="submit" id="loginBtn">Kirish</button>
      </form>
    </main>

    <!-- ============ Panel ============ -->
    <div class="adm-app" id="appView" hidden>
      <header class="adm-bar">
        <div class="adm-bar-in wrap">
          <a href="/" class="adm-logo" aria-label="Saytga o‘tish"><Logo height={24} label="Dimed" /></a>
          <span class="adm-tag">Admin</span>
          <nav class="adm-tabs" role="tablist" aria-label="Bo‘limlar">
            <button role="tab" class="adm-tab on" data-tab="doctors" aria-selected="true">Tashrif shifokorlari</button>
            <button role="tab" class="adm-tab" data-tab="bookings" aria-selected="false">Yozilganlar</button>
            <button role="tab" class="adm-tab" data-tab="media" aria-selected="false">Rasmlar</button>
          </nav>
          <button class="btn btn-ghost btn-sm adm-logout" id="logoutBtn" type="button">Chiqish</button>
        </div>
      </header>

      <main class="wrap adm-main">
        <!-- ---------- 1. Shifokorlar ---------- -->
        <section data-panel="doctors">
          <div class="adm-head">
            <div>
              <h1>Tashrif buyuruvchi shifokorlar</h1>
              <p class="adm-muted">Klinikaga maʼlum kunlarda keladigan shifokorlar. Saqlangan zahoti saytda koʻrinadi.</p>
            </div>
            <button class="btn" id="addDoctor" type="button">+ Yangi shifokor</button>
          </div>
          <div id="doctorList" class="adm-list"><p class="adm-muted">Yuklanmoqda…</p></div>
        </section>

        <!-- ---------- 2. Yozilganlar ---------- -->
        <section data-panel="bookings" hidden>
          <div class="adm-head">
            <div>
              <h1>Yozilganlar</h1>
              <p class="adm-muted">Saytdan yozilganlar. Holatni qabul kuni belgilang; «Bekor» qilingan vaqt saytda yana boʻsh koʻrinadi.</p>
            </div>
          </div>
          <div class="adm-filters glass">
            <div class="adm-quick" id="quickDays">
              <button type="button" class="adm-chip" data-range="today">Bugun</button>
              <button type="button" class="adm-chip" data-range="tomorrow">Ertaga</button>
              <button type="button" class="adm-chip" data-range="week">Kelgusi 7 kun</button>
              <button type="button" class="adm-chip" data-range="past">Oʻtgan 7 kun</button>
            </div>
            <label class="adm-fld inline"><span>Dan</span><input type="date" id="fFrom" /></label>
            <label class="adm-fld inline"><span>Gacha</span><input type="date" id="fTo" /></label>
            <label class="adm-fld inline grow"
              ><span>Shifokor</span>
              <select id="fDoctor"><option value="">Hammasi</option></select>
            </label>
            <button class="btn btn-ghost btn-sm" id="reloadBookings" type="button">Yangilash</button>
          </div>
          <div class="adm-counts" id="bookingCounts"></div>
          <div id="bookingList" class="adm-list"></div>
        </section>

        <!-- ---------- 3. Rasmlar ---------- -->
        <section data-panel="media" hidden>
          <div class="adm-head">
            <div>
              <h1>Saytdagi rasmlar</h1>
              <p class="adm-muted">
                Rasmni almashtirish uchun kod yoki GitHub kerak emas. Yuklangan rasm avtomatik kichraytiriladi va WebP
                qilinadi, bir necha soniyada saytda koʻrinadi.
              </p>
            </div>
          </div>
          <div id="mediaList"><p class="adm-muted">Yuklanmoqda…</p></div>
        </section>
      </main>
    </div>

    <!-- ============ Shifokor formasi ============ -->
    <dialog class="adm-dialog" id="doctorDialog" aria-labelledby="dTitle">
      <form id="doctorForm" novalidate>
        <div class="adm-dbar">
          <h2 id="dTitle">Yangi shifokor</h2>
          <button class="adm-x" type="button" data-close aria-label="Yopish">✕</button>
        </div>
        <div class="adm-dbody">
          <div class="adm-photo">
            <div class="adm-photo-prev" id="dPhotoPrev"><span>Rasm yoʻq</span></div>
            <div class="adm-photo-act">
              <label class="btn btn-ghost btn-sm adm-file">
                Rasm tanlash
                <input type="file" id="dPhotoFile" accept="image/jpeg,image/png,image/webp,image/*" />
              </label>
              <button class="adm-link" type="button" id="dPhotoRemove" hidden>Rasmni olib tashlash</button>
              <small class="adm-muted" id="dPhotoMsg">Kvadrat yoki portret surat yaxshi koʻrinadi. Avtomatik siqiladi.</small>
            </div>
          </div>

          <div class="adm-fieldset">
            <div class="adm-legend">Matnlar (uch tilda)</div>
            <div class="adm-seg" id="dLangs" role="tablist">
              {
                langs.map((l, i) => (
                  <button type="button" class:list={['adm-seg-btn', { on: i === 0 }]} data-lang={l.code}>
                    {l.label}
                    <i class="dot" data-dot={l.code} />
                  </button>
                ))
              }
            </div>
            {
              langs.map((l, i) => (
                <div class="adm-langpane" data-pane={l.code} hidden={i !== 0}>
                  <label class="adm-fld">
                    <span>Ism-familiya{l.code === 'uz' ? ' *' : ''}</span>
                    <input type="text" maxlength="80" data-f={`name.${l.code}`} placeholder={l.code === 'uz' ? 'Karimov Jasur' : 'Boʻsh boʻlsa — oʻzbekchasi'} />
                  </label>
                  <label class="adm-fld">
                    <span>Mutaxassislik{l.code === 'uz' ? ' *' : ''}</span>
                    <input type="text" maxlength="80" data-f={`specialty.${l.code}`} placeholder={l.code === 'uz' ? 'Travmatolog' : l.code === 'ru' ? 'Травматолог' : 'Traumatologist'} />
                  </label>
                  <label class="adm-fld">
                    <span>Qisqa maʼlumot</span>
                    <textarea rows="3" maxlength="600" data-f={`bio.${l.code}`} placeholder="Tajriba, qayerdan keladi, nimalarni davolaydi" />
                  </label>
                </div>
              ))
            }
            <small class="adm-muted">Rus va ingliz tilidagi maydonlar boʻsh qolsa, saytda oʻzbekchasi koʻrinadi.</small>
          </div>

          <div class="adm-fieldset">
            <div class="adm-legend">Qaysi kunlari keladi</div>
            <div class="adm-sub">Har hafta</div>
            <div class="adm-days" id="dWeekdays">
              {weekdays.map((w) => (
                <label class="adm-day"><input type="checkbox" value={w.n} /><span>{w.label}</span></label>
              ))}
            </div>
            <div class="adm-sub">Alohida sanalar</div>
            <div class="adm-dates" id="dDates"></div>
            <div class="adm-addrow">
              <input type="date" id="dDateInput" />
              <button class="btn btn-ghost btn-sm" type="button" id="dDateAdd">Qoʻshish</button>
            </div>
            <div class="adm-sub">Kelmaydigan sanalar <small class="adm-muted">(odatdagi kuni boʻlsa ham)</small></div>
            <div class="adm-dates" id="dSkip"></div>
            <div class="adm-addrow">
              <input type="date" id="dSkipInput" />
              <button class="btn btn-ghost btn-sm" type="button" id="dSkipAdd">Qoʻshish</button>
            </div>
          </div>

          <div class="adm-fieldset">
            <div class="adm-legend">Qabul soatlari</div>
            <div id="dShifts"></div>
            <button class="adm-link" type="button" id="dShiftAdd">+ oraliq qoʻshish (tanaffusdan keyin)</button>
            <div class="adm-sub">Bitta qabul davomiyligi</div>
            <div class="adm-seg wrapit" id="dSlot">
              {slotOptions.map((m) => <button type="button" class="adm-seg-btn" data-min={m}>{m} daq</button>)}
            </div>
          </div>

          <div class="adm-two">
            <label class="adm-fld">
              <span>Qabul narxi (soʻm) *</span>
              <input type="number" id="dPrice" min="0" step="1000" inputmode="numeric" placeholder="150000" />
            </label>
            <label class="adm-fld">
              <span>Tartib raqami</span>
              <input type="number" id="dSort" step="1" inputmode="numeric" placeholder="0" />
            </label>
          </div>
          <small class="adm-muted">Narx saytda koʻrsatiladi va klinika kassasida olinadi. Tartib: kichik raqamli karta oldinda.</small>

          <label class="adm-check">
            <input type="checkbox" id="dActive" checked />
            <span><b>Saytda koʻrinsin</b><small>Belgi olib tashlansa karta yashiriladi va yozilib boʻlmaydi.</small></span>
          </label>
        </div>
        <div class="adm-dfoot">
          <p class="adm-msg" id="dMsg" role="alert"></p>
          <div class="adm-actions">
            <button class="btn btn-ghost" type="button" data-close>Bekor qilish</button>
            <button class="btn" type="submit" id="dSave">Saqlash</button>
          </div>
        </div>
      </form>
    </dialog>

    <!-- Tasdiqlash oynasi (o'chirish va h.k.) -->
    <dialog class="adm-dialog small" id="confirmDialog">
      <div class="adm-dbody">
        <p id="confirmText"></p>
        <div class="adm-actions">
          <button class="btn btn-ghost" type="button" id="confirmNo">Yoʻq</button>
          <button class="btn adm-danger" type="button" id="confirmYes">Ha</button>
        </div>
      </div>
    </dialog>

    <div class="adm-toast" id="toast" role="status" aria-live="polite" hidden></div>

    <script>
      import { initAdmin } from '../lib/admin-panel';
      initAdmin();
    </script>
  </body>
</html>

<style is:global>
  .adm {
    min-height: 100vh;
  }

  .adm [hidden] {
    display: none !important;
  }

  .adm-muted {
    color: var(--muted);
    font-size: 14px;
  }

  small.adm-muted {
    font-size: 12.5px;
    display: block;
  }

  .adm-msg {
    color: var(--rose);
    font-weight: 600;
    font-size: 14px;
  }

  .adm-msg:empty {
    display: none;
  }

  .adm-wide {
    width: 100%;
  }

  .adm-link {
    background: none;
    border: 0;
    padding: 4px 0;
    color: var(--rose);
    font-weight: 650;
    font-size: 14px;
    text-align: left;
  }

  .adm-link:hover {
    text-decoration: underline;
  }

  /* kirish */
  .adm-login {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: var(--sp-3);
  }

  .adm-login-card {
    width: min(400px, 100%);
    border-radius: 22px;
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .adm-login-card h1 {
    font-size: 26px;
    font-weight: 750;
    margin-top: var(--sp-2);
  }

  /* maydonlar */
  .adm-fld {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .adm-fld > span {
    font-size: 12.5px;
    font-weight: 650;
    color: var(--muted);
  }

  .adm-fld input,
  .adm-fld select,
  .adm-fld textarea,
  .adm-addrow input,
  .adm-shift input {
    font: inherit;
    font-size: 15px;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 11px;
    border: 1.5px solid var(--line);
    background: var(--card-solid);
    color: var(--ink);
    min-width: 0;
  }

  .adm-fld textarea {
    resize: vertical;
    min-height: 80px;
  }

  .adm-fld input:focus,
  .adm-fld select:focus,
  .adm-fld textarea:focus,
  .adm-addrow input:focus,
  .adm-shift input:focus {
    outline: none;
    border-color: var(--rose);
    box-shadow: 0 0 0 3px var(--rose-soft);
  }

  /* header */
  .adm-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .adm-bar-in {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: 64px;
    flex-wrap: wrap;
  }

  .adm-logo {
    display: flex;
  }

  .adm-tag {
    font-size: 12px;
    font-weight: 700;
    color: var(--rose);
    background: var(--rose-soft);
    border-radius: 999px;
    padding: 3px 10px;
  }

  .adm-tabs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    flex: 1;
    min-width: 0;
  }

  .adm-tab {
    flex: none;
    border: 0;
    background: none;
    padding: 8px 16px;
    border-radius: 999px;
    font-weight: 650;
    font-size: 14px;
    color: var(--muted);
    white-space: nowrap;
  }

  .adm-tab:hover {
    color: var(--ink);
    background: var(--chip-bg);
  }

  .adm-tab.on {
    background: var(--rose);
    color: #fff;
  }

  @media (max-width: 700px) {
    .adm-bar-in {
      gap: var(--sp-2);
      padding-top: 8px;
      padding-bottom: 8px;
    }

    .adm-tabs {
      order: 3;
      flex-basis: 100%;
    }

    .adm-logout {
      margin-left: auto;
    }
  }

  .adm-main {
    padding-top: var(--sp-5);
    padding-bottom: var(--sp-7);
  }

  .adm-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-bottom: var(--sp-4);
  }

  .adm-head h1 {
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 750;
    margin-bottom: 6px;
  }

  .adm-head p {
    max-width: 62ch;
  }

  .adm-list {
    display: grid;
    gap: var(--sp-2);
  }

  /* shifokor qatori */
  .adm-doc {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    gap: var(--sp-3);
    align-items: center;
    padding: var(--sp-3);
    border-radius: 16px;
  }

  .adm-doc.off {
    opacity: 0.7;
  }

  .adm-ph {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    object-fit: cover;
    background: var(--rose-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    color: var(--rose);
    font-family: var(--font-display);
  }

  .adm-doc h3 {
    font-size: 16px;
    font-weight: 700;
  }

  .adm-doc .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }

  .adm-pill {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--chip-bg);
    border: 1px solid var(--line);
    color: var(--muted);
    white-space: nowrap;
  }

  .adm-pill.ok {
    color: var(--ok);
    background: var(--ok-bg);
    border-color: transparent;
  }

  .adm-pill.warn {
    color: var(--warn);
    background: var(--warn-bg);
    border-color: transparent;
  }

  .adm-pill.rose {
    color: var(--rose);
    background: var(--rose-soft);
    border-color: transparent;
  }

  .adm-doc .acts {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 720px) {
    .adm-doc {
      grid-template-columns: 56px minmax(0, 1fr);
    }

    .adm-ph {
      width: 56px;
      height: 56px;
    }

    .adm-doc .acts {
      grid-column: 1 / -1;
      justify-content: stretch;
    }

    .adm-doc .acts .btn {
      flex: 1;
    }
  }

  .adm-danger {
    background: #c62828;
    box-shadow: none;
  }

  .btn-ghost.adm-danger-ghost:hover {
    border-color: #c62828;
    color: #c62828;
  }

  .adm-empty {
    padding: var(--sp-5) var(--sp-4);
    border-radius: 16px;
    text-align: center;
    color: var(--muted);
  }

  /* filtrlar */
  .adm-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: flex-end;
    padding: var(--sp-3);
    border-radius: 16px;
    margin-bottom: var(--sp-3);
  }

  .adm-quick {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    flex-basis: 100%;
  }

  .adm-chip {
    border: 1px solid var(--line);
    background: var(--chip-bg);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 13.5px;
    font-weight: 600;
  }

  .adm-chip.on,
  .adm-chip:hover {
    border-color: var(--rose);
    color: var(--rose);
  }

  .adm-fld.inline {
    width: 160px;
  }

  .adm-fld.grow {
    flex: 1;
    min-width: 200px;
  }

  @media (max-width: 600px) {
    .adm-fld.inline {
      width: calc(50% - 8px);
    }

    .adm-fld.grow {
      flex-basis: 100%;
    }
  }

  .adm-counts {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: var(--sp-3);
  }

  .adm-counts button {
    font: inherit;
  }

  /* yozuv qatori */
  .adm-bk {
    display: grid;
    grid-template-columns: 96px minmax(0, 1.4fr) minmax(0, 1fr) 150px;
    gap: var(--sp-3);
    align-items: center;
    padding: 12px var(--sp-3);
    border-radius: 14px;
  }

  .adm-bk .when b {
    display: block;
    font-size: 17px;
    font-variant-numeric: tabular-nums;
  }

  .adm-bk .when small,
  .adm-bk .doc small {
    color: var(--muted);
    font-size: 12.5px;
  }

  .adm-bk .who b {
    display: block;
    overflow-wrap: anywhere;
  }

  .adm-bk .who a {
    color: var(--rose);
    font-weight: 650;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .adm-bk .doc {
    font-size: 13.5px;
  }

  .adm-bk select {
    font: inherit;
    font-size: 14px;
    font-weight: 650;
    min-height: 40px;
    border-radius: 10px;
    border: 1.5px solid var(--line);
    padding: 4px 8px;
    background: var(--card-solid);
    color: var(--ink);
  }

  .adm-bk[data-status='came'] select {
    border-color: var(--ok);
    color: var(--ok);
  }

  .adm-bk[data-status='no_show'] select {
    border-color: var(--warn);
    color: var(--warn);
  }

  .adm-bk[data-status='cancelled'] {
    opacity: 0.6;
  }

  .adm-bk[data-status='cancelled'] .who b {
    text-decoration: line-through;
  }

  .adm-daysep {
    font-weight: 750;
    font-size: 14px;
    margin-top: var(--sp-3);
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .adm-bk {
      grid-template-columns: 72px minmax(0, 1fr);
    }

    .adm-bk .doc,
    .adm-bk .st {
      grid-column: 2;
    }

    .adm-bk select {
      width: 100%;
    }
  }

  /* rasmlar */
  .adm-mgroup {
    margin-bottom: var(--sp-5);
  }

  .adm-mgroup h2 {
    font-size: 18px;
    font-weight: 750;
    margin-bottom: var(--sp-3);
  }

  .adm-mgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--sp-3);
  }

  .adm-mcard {
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .adm-mimg {
    aspect-ratio: 16 / 10;
    background: var(--chip-bg);
    position: relative;
  }

  .adm-mcard.doctor .adm-mimg {
    aspect-ratio: 1 / 1;
  }

  .adm-mimg img {
    width: 100%;
