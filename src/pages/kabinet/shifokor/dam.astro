---
import Cabinet from '../../../layouts/Cabinet.astro';
import SignInCard from '../../../components/SignInCard.astro';
import { t } from '../../../data/i18n';
---

<Cabinet
  title="Ish kunini o‘zgartirish — Shifokor kabineti"
  description="Kunni yopish, ta’tilga chiqish yoki boshqa vaqtda ishlash: bemorlarga xabar boradi."
  eyebrow="Shifokor kabineti"
  heading="Ish kunini o‘zgartirish"
  area="doctor"
  active="dam"
>
  <span class="sub" id="subtitle" slot="sub"></span>

  <div id="loading" class="state">Yuklanmoqda…</div>

  <SignInCard what={t('signin.what.doctor')} whatKey="signin.what.doctor" next="/kabinet/shifokor/dam" id="denied" hidden />

  <div id="content" hidden>
    <div class="card glass">
      <h2>Sanani tanlang</h2>
      <p class="hint">
        Kunni yoping yoki boshqa vaqtda ishlashingizni belgilang. Bekor bo‘lgan navbatlar
        bo‘shaydi va har bir bemorga Telegram orqali xabar boradi — ular boshqa vaqtga yozila oladi.
      </p>

      <!-- 14 kunlik chip-kalendar: har kun alohida tugma, yopiq kunlar belgilangan -->
      <div class="days" id="days" role="tablist" aria-label="Sana"></div>

      <div class="day-info" id="dayInfo"></div>

      <div id="openForm">
        <div class="modes" role="radiogroup" aria-label="Nima qilmoqchisiz?">
          <label class="mode">
            <input type="radio" name="mode" value="off" checked />
            <span>Ishga chiqa olmayman</span>
          </label>
          <label class="mode">
            <input type="radio" name="mode" value="hours" />
            <span>Boshqa vaqtda ishlayman</span>
          </label>
        </div>

        <div id="hoursBox" hidden>
          <div class="time-row">
            <label class="fld">
              <span>Boshlanishi</span>
              <input id="hFrom" type="time" step="900" value="09:00" />
            </label>
            <label class="fld">
              <span>Tugashi</span>
              <input id="hTo" type="time" step="900" value="13:00" />
            </label>
          </div>
          <p class="note" style="margin-top: 0">
            Faqat shu vaqt ichida navbat olinadi. Shu vaqtga to‘g‘ri kelmaydigan navbatlar bekor
            qilinadi, qolganlari joyida turadi.
          </p>
        </div>

        <label class="check">
          <input id="multi" type="checkbox" />
          <span>Bir necha kunga (ta’til)</span>
        </label>
        <div id="rangeBox" hidden>
          <label class="fld">
            <span>Oxirgi kun (shu kun ham kiradi)</span>
            <input id="toDate" type="date" />
          </label>
          <p class="note" id="rangeInfo" style="margin-top: 8px"></p>
        </div>

        <label class="fld" style="margin-top: 16px">
          <span>Sabab (ixtiyoriy — bemorlarga yuboriladi)</span>
          <input id="reason" type="text" maxlength="120" placeholder="Masalan: kasal bo‘lib qoldim" />
        </label>
        <p class="msg" id="msg" role="status" aria-live="polite"></p>
        <button class="btn danger" id="offBtn" type="button">Ishga chiqa olmayman</button>
      </div>

      <div id="closedForm" hidden>
        <p class="msg" id="msg2" role="status" aria-live="polite"></p>
        <button class="btn btn-ghost" id="openBtn" type="button">Kunni qayta ochish</button>
        <p class="note">
          Qayta ochilganda bekor qilingan navbatlar qaytmaydi — bemorlar yangidan yozilishi kerak.
        </p>
      </div>
    </div>
  </div>
</Cabinet>

<script>
  import { fetchDoctor, showDenied, type DoctorData } from '../../../lib/doctor-cabinet';
  import { addDaysKey, fmtKey, fromKey, OYLAR, WD } from '../../../lib/dates';

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  let todayKey = '';
  let current = '';
  let maxKey = '';
  let defaultShifts: { start: string; end: string }[] = [];
  const closed = new Set<string>();

  const mode = (): 'off' | 'hours' =>
    document.querySelector<HTMLInputElement>('input[name="mode"]:checked')?.value === 'hours'
      ? 'hours'
      : 'off';

  /** Tugma matni va yordamchi bloklar tanlangan rejimga qarab o‘zgaradi. */
  function syncForm() {
    const hours = mode() === 'hours';
    const multi = el<HTMLInputElement>('multi').checked;
    el('hoursBox').hidden = !hours;
    el('rangeBox').hidden = !multi;
    el('offBtn').textContent = hours ? 'Vaqtni o‘zgartirish' : 'Ishga chiqa olmayman';
    el('offBtn').classList.toggle('danger', !hours);

    const to = el<HTMLInputElement>('toDate');
    to.min = current;
    to.max = maxKey;
    if (multi && (!to.value || to.value < current)) to.value = current;
    const days = multi && to.value >= current ? daysBetween(current, to.value) : 1;
    el('rangeInfo').textContent = multi
      ? `${fmtKey(current)} — ${fmtKey(to.value || current)}: ${days} kun.`
      : '';
  }

  const daysBetween = (a: string, b: string) =>
    Math.round((fromKey(b).getTime() - fromKey(a).getTime()) / 86_400_000) + 1;

  function renderDays() {
    let html = '';
    for (let i = 0; i < 14; i++) {
      const key = addDaysKey(todayKey, i);
      const d = fromKey(key);
      html += `<button class="day${key === current ? ' on' : ''}${closed.has(key) ? ' closed' : ''}" role="tab"
        aria-selected="${key === current}" data-day="${key}" title="${closed.has(key) ? 'yopiq' : ''}">
        <span class="lab">${i === 0 ? 'Bugun' : i === 1 ? 'Ertaga' : WD[d.getDay()]}</span>
        <b>${d.getDate()}</b><small>${OYLAR[d.getMonth()]}</small>
      </button>`;
    }
    const box = el('days');
    box.innerHTML = html;
    box.querySelectorAll<HTMLButtonElement>('[data-day]').forEach((b) =>
      b.addEventListener('click', () => loadDay(b.dataset.day ?? todayKey)),
    );
  }

  const setMsg = (id: string, text: string, kind: 'error' | 'ok' | '' = '') => {
    const msg = el(id);
    msg.textContent = text;
    msg.className = `msg${kind ? ` ${kind}` : ''}`;
  };

  function renderDay(data: DoctorData) {
    if (data.dayOff) closed.add(data.date);
    else closed.delete(data.date);
    renderDays();

    const n = data.appointments.filter((a) => a.status !== 'done' && a.status !== 'no_show').length;
    const info = el('dayInfo');
    info.className = `day-info ${data.dayOff ? 'closed' : n ? 'busy' : 'free'}`;
    info.textContent = data.dayOff
      ? `${fmtKey(data.date)} — kun yopiq${data.offReason ? ` (${data.offReason})` : ''}.`
      : !data.isWorkday
        ? `${fmtKey(data.date)} — jadval bo‘yicha dam olish kuni.`
        : n
          ? `${fmtKey(data.date)} — ${n} ta navbat bor. Yopilsa hammasi bekor qilinadi.`
          : `${fmtKey(data.date)} — navbat yo‘q.`;

    el('openForm').hidden = data.dayOff;
    el('closedForm').hidden = !data.dayOff;
    setMsg('msg', '');
    setMsg('msg2', '');
    syncForm();
  }

  async function loadDay(date: string) {
    current = date;
    renderDays();
    const res = await fetchDoctor(date);
    if (!res.ok) return setMsg('msg', 'Maʼlumotni yuklab boʻlmadi.', 'error');
    renderDay(res.data);
  }

  el('offBtn').addEventListener('click', async () => {
    const btn = el<HTMLButtonElement>('offBtn');
    const reason = el<HTMLInputElement>('reason').value.trim();
    const hours = mode() === 'hours';
    const multi = el<HTMLInputElement>('multi').checked;
    const to = multi ? el<HTMLInputElement>('toDate').value || current : current;

    if (to < current) return setMsg('msg', 'Oxirgi kun boshlanish kunidan oldin bo‘lmasin.', 'error');
    const days = daysBetween(current, to);
    const range = days > 1 ? `${fmtKey(current)} — ${fmtKey(to)} (${days} kun)` : fmtKey(current);

    let shifts: { start: string; end: string }[] | undefined;
    if (hours) {
      const start = el<HTMLInputElement>('hFrom').value;
      const end = el<HTMLInputElement>('hTo').value;
      if (!start || !end) return setMsg('msg', 'Boshlanish va tugash vaqtini kiriting.', 'error');
      if (end <= start) return setMsg('msg', 'Tugash vaqti boshlanishidan keyin bo‘lsin.', 'error');
      shifts = [{ start, end }];
    }

    const question = hours
      ? `${range}: faqat ${shifts![0]!.start}–${shifts![0]!.end} ishlaysizmi?\nShu vaqtga to‘g‘ri kelmaydigan navbatlar bekor qilinadi, bemorlarga xabar boradi.`
      : `${range}: barcha navbatlar bekor qilinsinmi?\nBemorlarga xabar boradi.`;
    if (!confirm(question)) return;

    btn.disabled = true;
    setMsg('msg', 'Bajarilmoqda…');
    try {
      const res = await fetch('/api/doctor-off', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          from: current,
          to,
          ...(reason ? { reason } : {}),
          ...(shifts ? { shifts } : {}),
        }),
      });
      const data = (await res.json()) as { cancelled?: number; notified?: number; error?: string };
      if (!res.ok) return setMsg('msg', data.error ?? 'Bajarib boʻlmadi.', 'error');

      const summary = `Bekor qilingan navbatlar: ${data.cancelled ?? 0}, xabar berildi: ${data.notified ?? 0}.`;
      // Ta'tilda yopilgan kunlar chip-kalendarda ham belgilansin.
      if (!hours) for (let d = current; d <= to; d = addDaysKey(d, 1)) closed.add(d);
      await loadDay(current);
      if (hours) setMsg('msg', `Ish vaqti o‘zgardi (${range}). ${summary}`, 'ok');
      else setMsg('msg2', `Yopildi: ${range}. ${summary}`, 'ok');
    } catch {
      setMsg('msg', 'Internetga ulanishda muammo.', 'error');
    } finally {
      btn.disabled = false;
    }
  });

  document.querySelectorAll('input[name="mode"]').forEach((r) => r.addEventListener('change', syncForm));
  el('multi').addEventListener('change', syncForm);
  el('toDate').addEventListener('change', syncForm);

  el('openBtn').addEventListener('click', async () => {
    const btn = el<HTMLButtonElement>('openBtn');
    btn.disabled = true;
    setMsg('msg2', 'Ochilmoqda…');
    try {
      const res = await fetch('/api/doctor-schedule', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ date: current, dayOff: false }),
      });
      const data = (await res.json()) as { error?: string };
      if (!res.ok) return setMsg('msg2', data.error ?? 'Ochib boʻlmadi.', 'error');
      await loadDay(current);
      setMsg('msg', 'Kun qayta ochildi — slotlar yana ko‘rinadi.', 'ok');
    } catch {
      setMsg('msg2', 'Internetga ulanishda muammo.', 'error');
    } finally {
      btn.disabled = false;
    }
  });

  async function init() {
    const res = await fetchDoctor();
    if (!res.ok) return showDenied(res.status);
    const data = res.data;
    todayKey = data.today;
    current = data.date;
    maxKey = addDaysKey(todayKey, 90);
    defaultShifts = data.doctor.shifts;
    const first = defaultShifts[0];
    const last = defaultShifts[defaultShifts.length - 1];
    if (first && last) {
      el<HTMLInputElement>('hFrom').value = first.start;
      el<HTMLInputElement>('hTo').value = last.end;
    }
    el('subtitle').textContent = `${data.doctor.name} · ${data.doctor.job}`;
    el('loading').hidden = true;
    el('content').hidden = false;
    renderDay(data);
  }

  init();
</script>

<style>
  .sub {
    display: block;
    color: var(--rose);
    font-weight: 650;
    font-size: 14px;
    margin-top: 4px;
  }

  .state {
    text-align: center;
    padding: 48px 0;
    color: var(--muted);
    font-size: 15px;
  }

  .state .btn {
    margin-top: 16px;
  }

  .card {
    border-radius: 16px;
    padding: var(--card-pad);
    max-width: 720px;
  }

  .card h2 {
    font-size: 12px;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--muted);
    font-family: var(--font-sans);
    margin-bottom: 8px;
  }

  .hint {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 16px;
    line-height: 1.5;
  }

  .days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    margin-bottom: 16px;
  }

  .days :global(.day) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 8px 4px;
    border: 1px solid var(--card-brd);
    background: var(--chip-bg);
    color: var(--muted);
    border-radius: 10px;
    font-size: 12px;
    font-weight: 650;
    line-height: 1.2;
    cursor: pointer;
  }

  .days :global(.day b) {
    font-size: 16px;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .days :global(.day small) {
    font-size: 9.5px;
    font-weight: 600;
  }

  .days :global(.day.closed) {
    background: var(--busy);
    text-decoration: line-through;
  }

  .days :global(.day:hover) {
    border-color: var(--rose);
  }

  .days :global(.day.on) {
    border-color: var(--rose);
    background: var(--rose-soft);
    color: var(--rose);
  }

  .days :global(.day.on b) {
    color: var(--rose);
  }

  .days :global(.day:focus-visible) {
    outline: 2px solid var(--rose);
    outline-offset: 2px;
  }

  .day-info {
    font-size: 13.5px;
    font-weight: 600;
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 16px;
  }

  .day-info.free {
    background: var(--ok-bg);
    color: var(--ok);
  }

  .day-info.busy {
    background: var(--warn-bg);
    color: var(--warn);
  }

  .day-info.closed {
    background: var(--busy);
    color: var(--muted);
  }

  .fld {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fld span {
    font-size: 12.5px;
    font-weight: 650;
    color: var(--muted);
  }

  .fld input {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    border-radius: 10px;
    padding: 8px 16px;
    font: inherit;
    font-size: 14px;
  }

  .fld input:focus {
    border-color: var(--rose);
    outline: none;
  }

  .msg {
    min-height: 20px;
    margin: 16px 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }

  .msg.error {
    color: var(--rose);
  }

  .msg.ok {
    color: var(--leaf);
  }

  .modes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 16px;
  }

  .mode {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid var(--card-brd);
    background: var(--chip-bg);
    border-radius: 10px;
    font-size: 13.5px;
    font-weight: 650;
    cursor: pointer;
  }

  .mode:has(input:checked) {
    border-color: var(--rose);
    background: var(--rose-soft);
    color: var(--rose);
  }

  .time-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 8px;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 16px 0 8px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
  }

  #rangeBox,
  #hoursBox {
    margin-top: 8px;
  }

  .fld input[type='date'],
  .fld input[type='time'] {
    min-height: 40px;
  }

  .danger {
    width: 100%;
    background: transparent;
    color: var(--rose);
    border: 1.5px solid var(--rose);
    box-shadow: none;
  }

  .danger:hover {
    background: var(--rose-soft);
  }

  #openBtn {
    width: 100%;
  }

  .note {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 16px;
    line-height: 1.55;
  }

  @media (max-width: 600px) {
    .modes {
      grid-template-columns: 1fr;
    }

    .card {
      padding: 16px;
    }
  }
</style>
