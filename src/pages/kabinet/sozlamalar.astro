---
import Cabinet from '../../layouts/Cabinet.astro';
import SignInCard from '../../components/SignInCard.astro';
import { t } from '../../data/i18n';
import { LANGS, LANG_NAMES } from '../../data/i18n';
---

<Cabinet
  title="Sozlamalar — Dimed klinikasi"
  description="Hisob, oila a‘zolari va til sozlamalari."
  eyebrow="Shaxsiy kabinet"
  eyebrowKey="cab.eyebrow.patient"
  heading="Sozlamalar"
  headingKey="cabinet.menu.settings"
  area="patient"
  active="sozlamalar"
>
  <div id="loading" class="state" data-t="common.loading">Yuklanmoqda…</div>

  <SignInCard what={t('signin.what.settings')} whatKey="signin.what.settings" next="/kabinet/sozlamalar" hidden />

  <div id="content" class="grid" hidden>
    <div class="card glass">
      <h2 data-t="settings.account">Hisob</h2>
      <div class="kv"><span class="k" data-t="settings.name">Ism</span><span class="v" id="accName">—</span></div>
      <div class="kv"><span class="k" data-t="settings.phone">Telefon</span><span class="v" id="accPhone">—</span></div>
      <p class="note" data-t="settings.accountNote">
        Kirish Telegram orqali — parol yoʻq. Telefon raqami botga ulashgan kontaktdan olinadi.
      </p>
      <button class="btn btn-ghost btn-sm" id="logout" type="button" data-t="settings.logout">Chiqish</button>
    </div>

    <div class="card glass">
      <h2 data-t="settings.language">Til</h2>
      <p class="note top" data-t="settings.languageNote">Sayt va bot xabarlari tili.</p>
      <div class="seg" id="langSeg">
        {LANGS.map((l) => <button type="button" data-lang-pick={l}>{LANG_NAMES[l]}</button>)}
      </div>
      <p class="msg" id="langMsg" role="status" aria-live="polite"></p>
    </div>

    <div class="card glass full">
      <h2 data-t="settings.people">Bemorlar (oila a‘zolari)</h2>
      <p class="note top" data-t="settings.peopleNote">
        Bir telefondan butun oila foydalanishi mumkin. Navbat olishda «kim uchun» deb so'raladi — bu yerda tanlangan
        odam oldindan belgilanadi.
      </p>
      <div class="who-list" id="whoList"></div>
      <button class="btn btn-ghost btn-sm" id="whoNew" type="button" data-t="settings.addPerson">+ Boshqa odam qoʻshish</button>
      <div class="who-form" id="whoForm" hidden>
        <h3 class="form-title" id="whoFormTitle" hidden></h3>
        <p class="note top" id="whoFormNote" hidden></p>
        <div id="whoNames">
          <div class="two">
            <input id="w-last" type="text" data-t-placeholder="settings.lastName" placeholder="Familiya *" autocomplete="family-name" />
            <input id="w-first" type="text" data-t-placeholder="settings.firstName" placeholder="Ism *" autocomplete="given-name" />
          </div>
          <input id="w-mid" type="text" data-t-placeholder="settings.patronymic" placeholder="Sharif (ixtiyoriy)" />
        </div>
        <div class="fld-label" data-t="settings.birth">Tugʻilgan sana *</div>
        <div id="w-birth"></div>
        <div class="actions">
          <button class="btn btn-ghost btn-sm danger" id="whoRemove" type="button" data-t="settings.remove" hidden>Olib tashlash</button>
          <button class="btn btn-ghost btn-sm" id="whoCancel" type="button" data-t="settings.cancel">Bekor qilish</button>
          <button class="btn btn-sm" id="whoSave" type="button" data-t="settings.save">Saqlash</button>
        </div>
      </div>
      <p class="msg" id="whoMsg" role="status" aria-live="polite"></p>
    </div>

    <p class="foot full">
      <a href="/maxfiylik" data-t="settings.privacyLink">Maxfiylik siyosati</a> —
      <span data-t="settings.privacy">qanday maʼlumotlar saqlanadi va huquqlaringiz.</span>
    </p>
  </div>
</Cabinet>

<script>
  import { showSignIn } from '../../lib/signin';
  import { birthDateSelectsHtml, readBirthDate, formatBirthDate } from '../../lib/birthdate';
  import { getLang, setLang, applyLang, applyPageLang } from '../../lib/lang';
  import { isLang, t } from '../../data/i18n';
  import { site } from '../../data/site';

  type Patient = { id: string; name: string; source: '1c' | 'local'; birthDate: string | null };
  type SessionInfo = { role: string; name?: string; phone?: string; lang?: string; langSaved?: boolean };

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c);

  let lang = getLang();
  const tr = (key: Parameters<typeof t>[0], vars?: Record<string, string | number>) => t(key, lang, vars);

  const setMsg = (id: string, text: string, kind: 'error' | 'ok' | '' = '') => {
    const m = el(id);
    m.textContent = text;
    m.className = `msg${kind ? ` ${kind}` : ''}`;
  };

  const post = (url: string, body: unknown) =>
    fetch(url, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });

  /** Joriy tilga ko'ra sahifadagi qotirilgan matnlarni va select'larni yangilaydi. */
  function applyLanguage() {
    applyPageLang(lang);
    resetForm();
    renderPatients();
  }

  // ---------- til ----------
  function bindLang() {
    applyLang(lang, el('langSeg'));
    el('langSeg')
      .querySelectorAll<HTMLButtonElement>('[data-lang-pick]')
      .forEach((btn) =>
        btn.addEventListener('click', async () => {
          const picked = btn.dataset.langPick;
          if (!isLang(picked)) return;
          lang = picked;
          setLang(picked);
          applyLang(picked, el('langSeg'));
          applyLanguage();
          setMsg('langMsg', tr('settings.saving'));
          try {
            const res = await post('/api/settings', { lang: picked });
            setMsg('langMsg', res.ok ? tr('settings.langSaved') : tr('settings.saveFailed'), res.ok ? 'ok' : 'error');
          } catch {
            setMsg('langMsg', tr('common.error.network'), 'error');
          }
        }),
      );
  }

  // ---------- bemorlar ----------
  let patients: Patient[] = [];
  let activeId: string | null = null;
  /** Tahrirlanayotgan bemor (null — yangi odam qo'shilmoqda). */
  let editing: Patient | null = null;

  function renderPatients() {
    el('whoList').innerHTML = patients.length
      ? patients
          .map(
            (p) => `<div class="who-wrap">
              <button class="who-item${p.id === activeId ? ' on' : ''}" data-pick="${esc(p.id)}" type="button"
                title="${esc(tr('settings.selectHint'))}">
                <span class="who-nm">${esc(p.name)}</span>
                <span class="who-meta">${
                  p.birthDate ? esc(formatBirthDate(p.birthDate, lang)) : esc(tr('settings.noBirth'))
                }${p.source === '1c' ? ` · ${esc(tr('settings.inClinic'))}` : ''}</span>
                ${p.id === activeId ? `<span class="who-tag">${esc(tr('settings.selected'))}</span>` : ''}
              </button>
              <button class="who-edit" data-edit="${esc(p.id)}" type="button">${esc(tr('settings.edit'))}</button>
            </div>`,
          )
          .join('')
      : `<p class="empty">${esc(tr('settings.empty'))}</p>`;

    el('whoList')
      .querySelectorAll<HTMLButtonElement>('[data-pick]')
      .forEach((b) =>
        b.addEventListener('click', async () => {
          const id = b.dataset.pick ?? '';
          setMsg('whoMsg', tr('settings.saving'));
          try {
            const res = await post('/api/patients', { action: 'select', id });
            if (!res.ok) throw new Error(String(res.status));
            activeId = id;
            setMsg('whoMsg', tr('settings.selectSaved'), 'ok');
            renderPatients();
          } catch {
            setMsg('whoMsg', tr('settings.saveFailed'), 'error');
          }
        }),
      );

    el('whoList')
      .querySelectorAll<HTMLButtonElement>('[data-edit]')
      .forEach((b) =>
        b.addEventListener('click', () => {
          const person = patients.find((p) => p.id === b.dataset.edit);
          if (person) openForm(person);
        }),
      );
  }

  async function loadPatients() {
    const res = await fetch('/api/patients', { credentials: 'same-origin' });
    if (!res.ok) throw new Error(String(res.status));
    const data = (await res.json()) as { patients: Patient[]; activeId: string | null };
    patients = data.patients;
    activeId = data.activeId;
    renderPatients();
  }

  // ---------- forma: yangi odam yoki tuzatish ----------
  const input = (id: string) => el<HTMLInputElement>(id);

  /** Formani ochadi: `person` berilsa — tuzatish, bo'lmasa — yangi odam. */
  function openForm(person: Patient | null) {
    editing = person;
    const form = el('whoForm');
    form.hidden = false;
    el('whoNew').hidden = true;
    setMsg('whoMsg', '');

    const title = el('whoFormTitle');
    const note = el('whoFormNote');
    title.hidden = !person;
    title.textContent = person ? `${tr('settings.editTitle')}: ${person.name}` : '';

    // Klinika bazasidagi odamning ismi saytda o'zgarmaydi — faqat sana to'ldiriladi.
    const clinic = person?.source === '1c';
    el('whoNames').hidden = clinic;
    note.hidden = !clinic;
    note.textContent = clinic ? tr('settings.clinicFix', { phone: site.phone }) : '';
    el('whoRemove').hidden = !person || clinic;

    if (person && !clinic) {
      // Ism uch bo'lakka bo'linmagan (saqlangan "Familiya Ism Sharif") — taxminiy bo'lish.
      const [last = '', first = '', ...mid] = person.name.split(' ');
      input('w-last').value = last;
      input('w-first').value = first;
      input('w-mid').value = mid.join(' ');
    } else if (!person) {
      input('w-last').value = '';
      input('w-first').value = '';
      input('w-mid').value = '';
    }
    el('w-birth').innerHTML = birthDateSelectsHtml('new', lang, person?.birthDate ?? '');
    (clinic ? el('whoSave') : input('w-last')).focus();
  }

  function resetForm() {
    editing = null;
    el('whoForm').hidden = true;
    el('whoNew').hidden = false;
    el('whoFormTitle').hidden = true;
    el('whoRemove').hidden = true;
    el('w-birth').innerHTML = birthDateSelectsHtml('new', lang);
  }

  el('w-birth').innerHTML = birthDateSelectsHtml('new', lang);

  el('whoNew').addEventListener('click', () => openForm(null));

  el('whoCancel').addEventListener('click', () => {
    resetForm();
    setMsg('whoMsg', '');
  });

  el('whoRemove').addEventListener('click', async () => {
    if (!editing || !confirm(tr('settings.removeConfirm'))) return;
    const id = editing.id;
    setMsg('whoMsg', tr('settings.saving'));
    try {
      const res = await post('/api/patients', { action: 'remove', id });
      if (!res.ok) throw new Error(String(res.status));
      patients = patients.filter((p) => p.id !== id);
      if (activeId === id) activeId = null;
      resetForm();
      renderPatients();
      setMsg('whoMsg', tr('settings.removed'), 'ok');
    } catch {
      setMsg('whoMsg', tr('settings.saveFailed'), 'error');
    }
  });

  el('whoSave').addEventListener('click', async () => {
    const birthDate = readBirthDate(el('whoForm'), 'new');
    const clinic = editing?.source === '1c';

    const lastName = input('w-last').value.trim();
    const firstName = input('w-first').value.trim();
    const patronymic = input('w-mid').value.trim();

    if (!clinic && (!lastName || !firstName)) return setMsg('whoMsg', tr('settings.nameRequired'), 'error');
    if (!birthDate) return setMsg('whoMsg', tr('settings.birthRequired'), 'error');

    setMsg('whoMsg', tr('settings.saving'));
    try {
      if (editing) {
        const body = clinic
          ? { action: 'birthDate', id: editing.id, birthDate }
          : { action: 'edit', id: editing.id, firstName, lastName, patronymic, birthDate };
        const res = await post('/api/patients', body);
        const data = (await res.json()) as { error?: string; patient?: Patient };
        if (!res.ok || !data.patient) return setMsg('whoMsg', data.error ?? tr('settings.saveFailed'), 'error');
        patients = patients.map((p) => (p.id === data.patient?.id ? data.patient : p));
        resetForm();
        renderPatients();
        return setMsg('whoMsg', tr('settings.updated'), 'ok');
      }

      const res = await post('/api/patients', { action: 'add', firstName, lastName, patronymic, birthDate });
      const data = (await res.json()) as { error?: string; patient?: Patient; activeId?: string };
      if (!res.ok || !data.patient) return setMsg('whoMsg', data.error ?? tr('settings.saveFailed'), 'error');
      patients.push(data.patient);
      activeId = data.activeId ?? data.patient.id;
      resetForm();
      renderPatients();
      setMsg('whoMsg', tr('settings.added'), 'ok');
    } catch {
      setMsg('whoMsg', tr('common.error.network'), 'error');
    }
  });

  el('logout').addEventListener('click', async () => {
    await fetch('/api/logout', { method: 'POST', credentials: 'same-origin' }).catch(() => {});
    try {
      sessionStorage.removeItem('dimed_session');
    } catch {
      /* sessionStorage yopiq bo'lishi mumkin */
    }
    window.location.href = '/';
  });

  // ---------- yuklash ----------
  async function load() {
    let info: SessionInfo;
    try {
      const res = await fetch('/api/session', { credentials: 'same-origin' });
      if (!res.ok) throw new Error(String(res.status));
      info = await res.json();
    } catch {
      el('loading').textContent = tr('cab.loadFailed');
      return;
    }

    if (info.role === 'guest') {
      showSignIn(401);
      return;
    }

    el('accName').textContent = info.name || '—';
    el('accPhone').textContent = info.phone ?? '—';
    /*
      Serverda tanlab saqlangan til brauzerdagidan farq qilsa, serverniki ustun.
      Tanlanmagan bo'lsa (`langSaved` yo'q) server faqat standart uz beradi —
      bemorning brauzerdagi tanlovi o'zgarmaydi. Header ham yangi tilga
      o'tkaziladi: avval Sozlamalarda "O'zbekcha", menyu esa inglizcha qolardi.
    */
    if (info.langSaved && isLang(info.lang) && info.lang !== lang) {
      lang = info.lang;
      setLang(info.lang);
      applyLanguage();
      const header = document.getElementById('siteHeader');
      if (header) applyPageLang(lang, header);
    }
    bindLang();

    try {
      await loadPatients();
    } catch {
      el('whoList').innerHTML = `<p class="empty">${esc(tr('settings.listFailed'))}</p>`;
    }

    el('loading').hidden = true;
    el('content').hidden = false;
  }

  // Ma'lumot kelguncha ham input placeholder'lari tanlangan tilda bo'lsin.
  applyPageLang(lang);
  load();
</script>

<style>
  .state {
    text-align: center;
    padding: 48px 0;
    color: var(--muted);
    font-size: 15px;
  }

  .state .btn {
    margin-top: 16px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .full {
    grid-column: 1 / -1;
  }

  .card {
    border-radius: 16px;
    padding: var(--card-pad);
  }

  .card h2 {
    font-size: 12px;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--muted);
    font-family: var(--font-sans);
    margin-bottom: 16px;
  }

  .kv {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px dashed var(--line);
    font-size: 14px;
  }

  .kv .k {
    color: var(--muted);
  }

  .kv .v {
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .note {
    font-size: 12.5px;
    color: var(--muted);
    margin: 16px 0;
    line-height: 1.55;
  }

  .note.top {
    margin-top: 0;
  }

  .seg {
    display: flex;
    gap: 4px;
  }

  .seg button {
    flex: 1;
    border: 1px solid var(--card-brd);
    background: var(--chip-bg);
    border-radius: 10px;
    padding: 8px 4px;
    font-size: 13px;
    font-weight: 650;
  }

  .seg button.on {
    background: var(--rose);
    border-color: var(--rose);
    color: #fff;
  }

  .seg button:focus-visible {
    outline: 2px solid var(--rose);
    outline-offset: 2px;
  }

  .msg {
    min-height: 20px;
    margin-top: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }

  .msg.error {
    color: var(--rose);
  }

  .msg.ok {
    color: var(--leaf);
  }

  .who-list {
    display: grid;
    gap: 8px;
    margin-bottom: 8px;
  }

  .who-list :global(.empty) {
    color: var(--muted);
    font-size: 14px;
  }

  .who-list :global(.who-wrap) {
    display: flex;
    gap: 8px;
    align-items: stretch;
  }

  .who-list :global(.who-wrap .who-item) {
    flex: 1;
    min-width: 0;
  }

  .who-list :global(.who-edit) {
    flex: none;
    align-self: center;
    padding-block: 8px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 13px;
    font-weight: 650;
    cursor: pointer;
  }

  .who-list :global(.who-edit:hover) {
    color: var(--rose);
    border-color: var(--rose);
  }

  .form-title {
    font-size: 15px;
    font-weight: 700;
  }

  #whoNames {
    display: grid;
    gap: 8px;
  }

  .actions .danger {
    margin-right: auto;
    color: var(--rose);
    border-color: var(--rose);
  }

  .who-list :global(.who-item) {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    width: 100%;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .who-list :global(.who-item:hover) {
    border-color: var(--leaf);
  }

  .who-list :global(.who-item.on) {
    border-color: var(--leaf);
    background: color-mix(in srgb, var(--leaf) 8%, var(--card));
  }

  .who-list :global(.who-nm) {
    font-weight: 650;
    font-size: 15px;
  }

  .who-list :global(.who-meta) {
    font-size: 12.5px;
    color: var(--muted);
    flex: 1 1 100%;
    order: 2;
  }

  .who-list :global(.who-tag) {
    font-size: 12px;
    font-weight: 700;
    color: var(--ok);
    background: var(--ok-bg);
    border-radius: 999px;
    padding: 4px 8px;
  }

  .who-form {
    display: grid;
    gap: 8px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  @media (max-width: 520px) {
    .two {
      grid-template-columns: 1fr;
    }
  }

  .who-form input,
  .who-form :global(.birth-sel) {
    width: 100%;
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
    color: inherit;
    font: inherit;
    font-size: 14px;
  }

  .who-form input:focus-visible,
  .who-form :global(.birth-sel:focus-visible) {
    outline: none;
    border-color: var(--leaf);
  }

  .who-form :global(.birth-row) {
    display: grid;
    grid-template-columns: 1fr 1.6fr 1.2fr;
    gap: 8px;
  }

  .fld-label {
    font-size: 12px;
    font-weight: 650;
    color: var(--muted);
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  .foot {
    font-size: 13px;
    color: var(--muted);
  }

  .foot a {
    color: var(--rose);
    font-weight: 650;
  }
</style>
