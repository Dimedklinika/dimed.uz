---
import Cabinet from '../../layouts/Cabinet.astro';
import SignInCard from '../../components/SignInCard.astro';
import { t } from '../../data/i18n';
---

<Cabinet
  title="Navbatlarim — Dimed klinikasi"
  description="Kelgusi va o‘tgan qabullaringiz, vaqtni ko‘chirish."
  eyebrow="Shaxsiy kabinet"
  heading="Navbatlarim"
  area="patient"
  active="navbatlar"
>
  <span class="phone-chip" id="phoneChip" slot="sub" hidden></span>
  <a class="btn btn-sm" href="/#navbat-widget" slot="actions">Navbat olish</a>

  <!--
    Bir telefonga oila a'zolari bog'langan bo'lishi mumkin. Shunda
    kimning qabuli ekanini ajratish uchun filtr chiqadi.
  -->
  <div class="who-bar" id="whoBar" hidden>
    <span class="who-lab">Kim:</span>
    <div class="who-chips" id="whoChips"></div>
  </div>

  <div id="loading" class="state">Yuklanmoqda…</div>

  <SignInCard what={t('signin.what.appointments')} next="/kabinet/navbatlar" hidden />

  <div id="content" class="grid" hidden>
    <div class="card glass">
      <h2>Kelgusi qabullar</h2>
      <div id="upcoming"></div>
    </div>

    <div class="card glass">
      <h2>O‘tgan qabullar</h2>
      <div id="past"></div>
    </div>
  </div>
</Cabinet>

<script>
  import { showSignIn } from '../../lib/signin';
  type Appointment = {
    doctorId: string;
    doctorName: string;
    doctorJob: string;
    date: string;
    time: string;
    status: string;
    price: number;
    upcoming: boolean;
    canMove: boolean;
    /* Navbat kim uchun olingani (bir telefon — bir oila). */
    patientName: string | null;
    /* Tanlangan qo'shimcha xizmat (massaj, UZI ...); asosiy qabulda yo'q. */
    serviceName: string | null;
  };

  type Slot = { time: string; free: boolean };

  const MONTHS = [
    'yanvar', 'fevral', 'mart', 'aprel', 'may', 'iyun',
    'iyul', 'avgust', 'sentabr', 'oktabr', 'noyabr', 'dekabr',
  ];

  const WD = ['Yak', 'Du', 'Se', 'Chor', 'Pay', 'Ju', 'Sh'];

  const fmtDate = (key: string) => {
    const [y, m, d] = key.split('-').map(Number);
    return m && d ? `${d}-${MONTHS[m - 1]} ${y}` : key;
  };

  const fmtPrice = (n: number) => n.toLocaleString('ru-RU').replace(/,/g, ' ') + ' soʻm';

  const statusLabel: Record<string, { text: string; cls: string }> = {
    paid: { text: 'toʻlangan', cls: 'ok' },
    booked: { text: 'band qilingan', cls: 'ok' },
    done: { text: 'boʻlib oʻtgan', cls: 'muted' },
    no_show: { text: 'kelmagan', cls: 'warn' },
    moved: { text: 'koʻchirilgan', cls: 'warn' },
    cancelled_by_clinic: { text: 'klinika bekor qildi', cls: 'warn' },
  };

  /** Ko'chirish oynasi ochilgan qabul: "doctorId|sana|vaqt". */
  let openMove = '';

  /* Tanlangan bemor (bo'sh — hammasi). */
  let whoFilter = '';
  const matchesWho = (name: string | null) => !whoFilter || name === whoFilter;

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (t: string) =>
    t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c);

  /** Qabullarda uchraydigan ismlar — filtr chiplari. */
  function renderWhoBar(appointments: Appointment[]) {
    const names = [
      ...new Set(appointments.map((a) => a.patientName).filter((n): n is string => Boolean(n))),
    ].sort((a, b) => a.localeCompare(b));

    if (names.length < 2) {
      el('whoBar').hidden = true;
      return;
    }

    el('whoBar').hidden = false;
    el('whoChips').innerHTML = [
      `<button class="who-chip${whoFilter ? '' : ' on'}" data-who="">Hammasi</button>`,
      ...names.map(
        (n) => `<button class="who-chip${whoFilter === n ? ' on' : ''}" data-who="${esc(n)}">${esc(n)}</button>`,
      ),
    ].join('');

    el('whoChips')
      .querySelectorAll<HTMLButtonElement>('[data-who]')
      .forEach((b) =>
        b.addEventListener('click', () => {
          whoFilter = b.dataset.who ?? '';
          renderWhoBar(appointments);
          renderAppointments(appointments);
        }),
      );
  }

  async function load() {
    let data: { phone: string; appointments: Appointment[] };

    try {
      const res = await fetch('/api/me?include=appointments', { credentials: 'same-origin' });
      if (res.status === 401) {
        showSignIn(401);
        return;
      }
      if (!res.ok) throw new Error(String(res.status));
      data = await res.json();
    } catch {
      el('loading').textContent = 'Ma’lumotlarni yuklab bo‘lmadi. Sahifani yangilang.';
      return;
    }

    el('loading').hidden = true;
    el('content').hidden = false;

    const chip = el('phoneChip');
    chip.textContent = data.phone;
    chip.hidden = false;

    renderWhoBar(data.appointments);
    renderAppointments(data.appointments);
  }

  function renderAppointments(everything: Appointment[]) {
    const all = everything.filter((a) => matchesWho(a.patientName));
    const upcoming = all.filter((a) => a.upcoming);
    const past = all.filter((a) => !a.upcoming).reverse();

    el('upcoming').innerHTML = upcoming.length
      ? upcoming.map(appointmentCard).join('')
      : `<p class="empty">Hozircha kelgusi qabul yoʻq.<br><a class="btn btn-sm" href="/#navbat-widget">Navbat olish</a></p>`;

    el('past').innerHTML = past.length
      ? past
          .map((a) => {
            const s = statusLabel[a.status] ?? { text: a.status, cls: 'muted' };
            return `<div class="row"><span>${esc(a.doctorJob || a.doctorName)} — ${esc(a.doctorName)}${
              a.patientName ? `<small class="who">${esc(a.patientName)}</small>` : ''
            }</span>
               <span class="dt">${fmtDate(a.date)} · ${a.time} <span class="pill ${s.cls}">${s.text}</span></span></div>`;
          })
          .join('')
      : '<p class="empty">Oʻtgan qabullar yoʻq.</p>';

    // Qayta chizishdan keyin ochiq turgan ko'chirish oynasini tiklaymiz.
    if (openMove && panelOf(openMove)) loadSlots(openMove);
    else openMove = '';
  }

  /** Qabulni bir qatorda aniqlaydigan kalit. */
  const keyOf = (a: Appointment) => `${a.doctorId}|${a.date}|${a.time}`;
  const partsOf = (key: string) => {
    const [doctor = '', date = '', time = ''] = key.split('|');
    return { doctor, date, time };
  };

  const dayKey = (offset = 0) => {
    const d = new Date();
    d.setDate(d.getDate() + offset);
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  };

  const panelOf = (key: string) =>
    document.querySelector<HTMLDivElement>(`[data-panel="${key}"]`);
  const pick = <T extends HTMLElement>(attr: string, key: string) =>
    document.querySelector<T>(`[data-${attr}="${key}"]`);

  function appointmentCard(a: Appointment) {
    const s = statusLabel[a.status] ?? { text: a.status, cls: 'muted' };
    const key = keyOf(a);

    /*
      Ko'chirish tugmasi faqat kuchdagi bronda va qabulga 1 soatdan
      ko'p qolganda chiqadi — bu qoidani server ham qayta tekshiradi.
      Sana o'z tugmalarimiz bilan tanlanadi: brauzer kalendari qurilma
      tilida ochiladi, tugmalar esa har doim o'zbekcha.
    */
    const move = a.canMove
      ? `<div class="appt-btns">
           <button class="mv-btn" data-move="${key}">Vaqtni koʻchirish</button>
           <button class="mv-btn danger" data-cancel="${key}">Bekor qilish</button>
         </div>
         <div class="mv" data-panel="${key}" hidden>
           <div class="mv-lab">Yangi sana</div>
           <div class="mv-days" data-days="${key}"></div>
           <div class="mv-slots" data-slots="${key}"></div>
           <p class="mv-msg" data-msg="${key}" role="status" aria-live="polite"></p>
         </div>`
      : '';

    return `<div class="appt">
      <div>
        <div class="nm">${esc(a.doctorName)}</div>
        <div class="dt">${esc(a.doctorJob)}</div>
        ${a.serviceName ? `<div class="dt who">Xizmat: ${esc(a.serviceName)}</div>` : ''}
        <div class="dt">${fmtDate(a.date)} · soat ${a.time}</div>
        ${a.patientName ? `<div class="dt who">Bemor: ${esc(a.patientName)}</div>` : ''}
      </div>
      <div class="appt-foot">
        <span class="pill ${s.cls}">${s.text}</span>
        <span class="dt">${
          a.price === 0
            ? 'bepul' // qayta ko'rik kabi bepul xizmat: "0 soʻm · kassada toʻlanadi" deyilmaydi
            : `${fmtPrice(a.price)} · ${a.status === 'paid' ? 'onlayn toʻlangan' : 'kassada toʻlanadi'}`
        }</span>
      </div>
      ${move}
    </div>`;
  }

  /** Ko'chirish oynasida tanlangan yangi sana (kalit -> YYYY-MM-DD). */
  const moveDates: Record<string, string> = {};

  /** Kelgusi 14 kun uchun o'zbekcha sana tugmalari. */
  function renderDays(key: string) {
    const box = pick<HTMLDivElement>('days', key);
    if (!box) return;

    const selected = moveDates[key] ?? (moveDates[key] = dayKey());
    let html = '';
    for (let i = 0; i < 14; i++) {
      const d = new Date();
      d.setDate(d.getDate() + i);
      const value = dayKey(i);
      html += `<button class="mv-day${value === selected ? ' on' : ''}"
        data-day="${key}" data-value="${value}"
        aria-label="${d.getDate()}-${MONTHS[d.getMonth()]}">
        ${WD[d.getDay()]}<b>${d.getDate()}</b><small>${MONTHS[d.getMonth()].slice(0, 3)}</small>
      </button>`;
    }
    box.innerHTML = html;
  }

  /** Tanlangan kun uchun bo'sh slotlarni yuklaydi. */
  async function loadSlots(key: string) {
    const panel = panelOf(key);
    const box = pick<HTMLDivElement>('slots', key);
    if (!panel || !box) return;

    panel.hidden = false;
    renderDays(key);
    box.innerHTML = '<span class="mv-hint">Yuklanmoqda…</span>';
    setMoveMsg(key, '');

    const { doctor } = partsOf(key);
    try {
      const res = await fetch(
        `/api/slots?doctor=${encodeURIComponent(doctor)}&date=${encodeURIComponent(moveDates[key] ?? dayKey())}`,
      );
      const data = (await res.json()) as { slots?: Slot[]; reason?: string; error?: string };
      if (!res.ok) throw new Error(data.error ?? String(res.status));

      const free = (data.slots ?? []).filter((s) => s.free);
      box.innerHTML = free.length
        ? free
            .map((s) => `<button class="mv-slot" data-slot="${key}" data-time="${s.time}">${s.time}</button>`)
            .join('')
        : `<span class="mv-hint">${data.reason ?? 'Bu kuni boʻsh vaqt yoʻq.'}</span>`;
    } catch {
      box.innerHTML = '<span class="mv-hint">Slotlarni yuklab boʻlmadi.</span>';
    }
  }

  function setMoveMsg(key: string, text: string, kind: 'error' | 'ok' | '' = '') {
    const msg = pick<HTMLParagraphElement>('msg', key);
    if (!msg) return;
    msg.textContent = text;
    msg.className = `mv-msg${kind ? ` ${kind}` : ''}`;
  }

  /*
    Bekor qilish: kela olmaydigan bemor slotni o'zi bo'shatadi — avval
    faqat ko'chirish bor edi va kelmagan bemorning vaqti o'lik ketardi.
    Qoida ko'chirish bilan bir xil: qabulga 1 soatdan ko'p qolgan bo'lsa.
  */
  async function cancelAppointment(key: string) {
    const { doctor, date, time } = partsOf(key);
    if (!confirm('Navbat bekor qilinsinmi? Vaqt boshqa bemorlarga ochiladi.')) return;

    setMoveMsg(key, 'Bekor qilinmoqda…');
    try {
      const res = await fetch('/api/cancel', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ doctor, date, time }),
      });
      const data = (await res.json()) as { error?: string };
      if (!res.ok) {
        setMoveMsg(key, data.error ?? 'Bekor qilib boʻlmadi.', 'error');
        return;
      }
      openMove = '';
      await load();
    } catch {
      setMoveMsg(key, 'Internetga ulanishda muammo.', 'error');
    }
  }

  async function moveTo(key: string, toTime: string) {
    const toDate = moveDates[key];
    if (!toDate) return;

    const { doctor, date, time } = partsOf(key);
    setMoveMsg(key, 'Koʻchirilmoqda…');

    try {
      const res = await fetch('/api/reschedule', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ doctor, date, time, toDate, toTime }),
      });
      const data = (await res.json()) as { error?: string };

      if (!res.ok) {
        setMoveMsg(key, data.error ?? 'Koʻchirib boʻlmadi.', 'error');
        if (res.status === 409) loadSlots(key);
        return;
      }

      openMove = '';
      await load();
    } catch {
      setMoveMsg(key, 'Internetga ulanishda muammo.', 'error');
    }
  }

  /* Kartochkalar qaytadan chiziladi — hodisalar ota-elementda ushlanadi. */
  el('upcoming').addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const cancel = target.closest<HTMLButtonElement>('[data-cancel]');
    if (cancel) {
      void cancelAppointment(cancel.dataset.cancel ?? '');
      return;
    }

    const move = target.closest<HTMLButtonElement>('[data-move]');
    if (move) {
      const key = move.dataset.move ?? '';
      if (openMove === key) {
        openMove = '';
        const panel = panelOf(key);
        if (panel) panel.hidden = true;
      } else {
        if (openMove) {
          const previous = panelOf(openMove);
          if (previous) previous.hidden = true;
        }
        openMove = key;
        loadSlots(key);
      }
      return;
    }

    const day = target.closest<HTMLButtonElement>('[data-day]');
    if (day) {
      const key = day.dataset.day ?? '';
      moveDates[key] = day.dataset.value ?? '';
      loadSlots(key);
      return;
    }

    const slot = target.closest<HTMLButtonElement>('[data-slot]');
    if (slot) moveTo(slot.dataset.slot ?? '', slot.dataset.time ?? '');
  });

  load();
</script>

<style>
  .phone-chip {
    display: inline-block;
    margin-top: 8px;
    font-size: 12px;
    font-weight: 650;
    color: var(--muted);
    background: var(--chip-bg);
    border: 1px solid var(--card-brd);
    border-radius: 999px;
    padding: 4px 16px;
    font-variant-numeric: tabular-nums;
  }

  .state {
    text-align: center;
    padding: 48px 0;
    color: var(--muted);
    font-size: 15px;
  }

  .state .btn {
    margin-top: 16px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    border-radius: 16px;
    padding: var(--card-pad);
  }

  .card h2 {
    font-size: 12px;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--muted);
    font-family: var(--font-sans);
    margin-bottom: 16px;
  }

  .card :global(.empty) {
    color: var(--muted);
    font-size: 14px;
    text-align: center;
    padding: 16px 0;
    line-height: 1.8;
  }

  .card :global(.appt) {
    background: var(--chip-bg);
    border: 1px solid var(--card-brd);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card :global(.appt:last-child) {
    margin-bottom: 0;
  }

  .card :global(.nm) {
    font-weight: 700;
    font-size: 14.5px;
    line-height: 1.3;
  }

  .card :global(.dt) {
    font-size: 12.5px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .card :global(.appt-foot) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .card :global(.pill) {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    border-radius: 999px;
    padding: 4px 8px;
  }

  .card :global(.pill.ok) {
    color: var(--ok);
    background: var(--ok-bg);
  }

  .card :global(.pill.warn) {
    color: var(--warn);
    background: var(--warn-bg);
  }

  .card :global(.pill.muted) {
    color: var(--muted);
    background: var(--busy);
  }

  .card :global(.appt-btns) {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .card :global(.mv-btn.danger) {
    color: var(--rose);
  }

  .card :global(.mv-btn.danger:hover) {
    border-color: var(--rose);
    background: var(--rose-soft);
  }

  /* Vaqtni ko'chirish */
  .card :global(.mv-btn) {
    align-self: flex-start;
    border: 1px solid var(--card-brd);
    background: none;
    color: var(--leaf);
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 12.5px;
    font-weight: 650;
  }

  .card :global(.mv-btn:hover) {
    border-color: var(--leaf);
    background: var(--leaf-soft);
  }

  .card :global(.mv-btn:focus-visible) {
    outline: 2px solid var(--leaf);
    outline-offset: 2px;
  }

  .card :global(.mv) {
    border-top: 1px dashed var(--line);
    padding-top: 16px;
  }

  .card :global(.mv-lab) {
    font-size: 12.5px;
    font-weight: 650;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .card :global(.mv-days) {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    padding-bottom: 4px;
    margin-bottom: 8px;
    scrollbar-width: thin;
  }

  .card :global(.mv-day) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    min-width: 46px;
    border: 1px solid var(--card-brd);
    background: var(--chip-bg);
    color: var(--muted);
    border-radius: 10px;
    padding: 8px;
    font-size: 12px;
    font-weight: 650;
    line-height: 1.25;
    flex-shrink: 0;
  }

  .card :global(.mv-day b) {
    font-size: 14.5px;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .card :global(.mv-day small) {
    font-size: 9.5px;
    font-weight: 600;
  }

  .card :global(.mv-day:hover) {
    border-color: var(--leaf);
  }

  .card :global(.mv-day.on) {
    border-color: var(--leaf);
    background: var(--leaf-soft);
    color: var(--leaf);
  }

  .card :global(.mv-day.on b) {
    color: var(--leaf);
  }

  .card :global(.mv-day:focus-visible) {
    outline: 2px solid var(--leaf);
    outline-offset: 2px;
  }

  .card :global(.mv-slots) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .card :global(.mv-slot) {
    border: 1px solid var(--card-brd);
    background: var(--chip-bg);
    color: var(--ink);
    border-radius: 9px;
    padding: 8px 16px;
    font-size: 12.5px;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .card :global(.mv-slot:hover) {
    border-color: var(--leaf);
    background: var(--leaf-soft);
    color: var(--leaf);
  }

  .card :global(.mv-slot:focus-visible) {
    outline: 2px solid var(--leaf);
    outline-offset: 2px;
  }

  .card :global(.mv-hint) {
    font-size: 12.5px;
    color: var(--muted);
  }

  .card :global(.mv-msg:empty) {
    display: none;
  }

  .card :global(.mv-msg) {
    margin-top: 8px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--muted);
  }

  .card :global(.mv-msg.error) {
    color: var(--rose);
  }

  .card :global(.mv-msg.ok) {
    color: var(--leaf);
  }

  .card :global(.row) {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 1px dashed var(--line);
    font-size: 13.5px;
    flex-wrap: wrap;
  }

  .card :global(.row:last-child) {
    border-bottom: none;
  }

  .card :global(.row .who) {
    display: block;
    font-size: 12px;
    color: var(--leaf);
    font-weight: 600;
  }

  .card :global(.dt.who) {
    color: var(--leaf);
    font-weight: 600;
  }

  /* Bemor filtri */
  .who-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .who-lab {
    font-size: 13px;
    color: var(--muted);
  }

  .who-chips {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .who-chips :global(.who-chip) {
    border: 1px solid var(--line);
    background: var(--card);
    color: inherit;
    font: inherit;
    font-size: 13px;
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
  }

  .who-chips :global(.who-chip:hover) {
    border-color: var(--leaf);
  }

  .who-chips :global(.who-chip.on) {
    border-color: var(--leaf);
    background: color-mix(in srgb, var(--leaf) 12%, var(--card));
    font-weight: 650;
  }
</style>
