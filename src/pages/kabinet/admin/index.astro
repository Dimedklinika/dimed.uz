---
import Cabinet from '../../../layouts/Cabinet.astro';
import SignInCard from '../../../components/SignInCard.astro';
import { t } from '../../../data/i18n';
import { departments } from '../../../data/departments';
import { AGE_GROUPS, ageLabel } from '../../../lib/age';

const slotOptions = [10, 15, 20, 30, 60];
const weekdays = [
  { n: 1, label: 'Du' },
  { n: 2, label: 'Se' },
  { n: 3, label: 'Chor' },
  { n: 4, label: 'Pay' },
  { n: 5, label: 'Ju' },
  { n: 6, label: 'Sh' },
  { n: 0, label: 'Yak' },
];
---

<Cabinet
  title="Admin — Dimed klinikasi"
  description="Shifokorlarni boshqarish: qo‘shish, tahrirlash, yashirish."
  eyebrow="Administrator"
  heading="Shifokorlarni boshqarish"
  area="admin"
  active="shifokorlar"
>
  <span class="sub" id="subtitle" slot="sub"></span>
  <button class="btn btn-sm" id="addBtn" slot="actions" hidden>+ Yangi shifokor</button>

  <div id="loading" class="state">Yuklanmoqda…</div>

  <SignInCard what={t('signin.what.admin')} next="/kabinet/admin" id="denied" hidden />

  <div id="content" hidden>
    <div id="list" class="doc-rows"></div>
  </div>

  <!-- Tahrirlash / qo'shish oynasi -->
  <div id="modal" class="modal" hidden>
    <div class="modal-card card glass">
      <div class="modal-head">
        <h2 id="formTitle">Yangi shifokor</h2>
        <button class="x" id="closeForm" aria-label="Yopish">✕</button>
      </div>

      <div class="form">
        <label class="fld">
          <span>ID (lotincha, masalan <code>ashurov</code>)</span>
          <input id="f-id" type="text" autocomplete="off" placeholder="ashurov" />
        </label>

        <div class="two">
          <label class="fld"><span>Ism</span><input id="f-name" type="text" /></label>
          <label class="fld"><span>Lavozim</span><input id="f-job" type="text" placeholder="Terapevt" /></label>
        </div>

        <div class="two">
          <label class="fld">
            <span>Bo‘lim</span>
            <select id="f-dept">
              {departments.map((d) => <option value={d.id}>{d.name}</option>)}
            </select>
          </label>
          <label class="fld"><span>Narx (so‘m)</span><input id="f-price" type="number" min="0" step="1000" /></label>
        </div>

        <div class="fld">
          <span>Qabul davomiyligi</span>
          <div class="seg" id="f-slot">
            {slotOptions.map((m) => <button type="button" data-min={m}>{m} daq</button>)}
          </div>
        </div>

        <div class="fld">
          <span>Bemor yoshi</span>
          <div class="seg" id="f-age">
            {AGE_GROUPS.map((g) => <button type="button" data-age={g}>{ageLabel(g)}</button>)}
          </div>
          <small class="fld-note">Pediatr faqat bolalarni, kattalar shifokori faqat kattalarni qabul qilsin.</small>
        </div>

        <div class="fld">
          <span>Ish kunlari</span>
          <div class="days" id="f-days">
            {weekdays.map((w) => (
              <label class="day"><input type="checkbox" value={w.n} />{w.label}</label>
            ))}
          </div>
        </div>

        <div class="fld">
          <span>Smenalar (tanaffus — smenalar orasidagi bo‘shliq)</span>
          <div id="f-shifts"></div>
          <button class="add" id="addShift" type="button">+ smena qo‘shish</button>
        </div>

        <div class="two">
          <label class="fld"><span>Tajriba</span><input id="f-exp" type="text" placeholder="20+ yil" /></label>
          <label class="fld"><span>Ish vaqti (yozuv)</span><input id="f-hours" type="text" placeholder="Du–Sh · 08:00–17:00" /></label>
        </div>

        <div class="two">
          <label class="fld"><span>Rasm (yo‘l)</span><input id="f-photo" type="text" placeholder="/images/team/ashurov.webp" /></label>
          <label class="fld"><span>Shifokor telefoni</span><input id="f-phone" type="tel" placeholder="+998 90 123 45 67" /></label>
        </div>

        <label class="fld">
          <span>Qo‘shimcha xizmatlar (ixtiyoriy)</span>
          <textarea
            id="f-services"
            rows="4"
            spellcheck="false"
            placeholder={'Massaj | 50000 | 1C kodi\nQayta ko‘rik | bepul | qayta:10'}></textarea>
          <small class="fld-note">
            Har qatorda bitta xizmat: <code>Nomi | narx | 1C kodi | qayta:N</code>. Narx — so‘m yoki
            «bepul». 1C kodi (Tovar va xizmatlar katalogidagi kod) ixtiyoriy: navbat 1C ga shu xizmat
            bilan tushadi. <code>qayta:10</code> — «qayta ko‘rik»: shu shifokorga oddiy qabulga kelgan
            bemor qabuldan keyin 10 kun ichida necha marta bo‘lsa ham oladi. Asosiy qabul narxi
            yuqoridagi «Narx». Xizmat yozilmasa, bemor faqat asosiy qabulni ko‘radi.
          </small>
        </label>

        <label class="fld">
          <span>Telegram ID (kabinetiga kirishi uchun — ixtiyoriy)</span>
          <input id="f-tg" type="text" inputmode="numeric" placeholder="masalan 123456789" />
        </label>

        <label class="chk">
          <input id="f-active" type="checkbox" checked /> Saytda ko‘rinsin
          <small>Belgi olib tashlansa, bemorlar uni ko‘rmaydi va navbat ololmaydi.</small>
        </label>

        <p class="msg" id="formMsg" role="status" aria-live="polite"></p>
        <div class="modal-actions">
          <button class="btn btn-ghost btn-sm" id="cancelForm" type="button">Bekor qilish</button>
          <button class="btn" id="saveForm" type="button">Saqlash</button>
        </div>
      </div>
    </div>
  </div>
</Cabinet>

<script>
  import { t } from '../../../data/i18n';
  import { getLang } from '../../../lib/lang';
  import { showSignIn } from '../../../lib/signin';

  type Shift = { start: string; end: string };
  type Doctor = {
    id: string;
    name: string;
    job: string;
    deptId: string;
    price: number;
    slotMinutes: number;
    workdays: number[];
    shifts: Shift[];
    experience: string;
    photo: string;
    hours: string;
    phone: string;
    active: boolean;
    ageGroup: 'all' | 'adult' | 'child';
    /** Qo'shimcha xizmatlar, har qatorda bittadan ("Nomi | narx | 1C kodi | qayta:N"). */
    servicesText: string;
    telegramId: string;
    linked: boolean;
  };

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const DEPT_NAMES: Record<string, string> = {
    pediatriya: 'Pediatriya',
    terapiya: 'Terapiya',
    ginekologiya: 'Ginekologiya',
    nevrologiya: 'Nevrologiya',
    lor: 'LOR',
    fizio: 'Fizioterapiya',
  };
  const fmtPrice = (n: number) => n.toLocaleString('ru-RU').replace(/,/g, ' ');

  const AGE_TEXT: Record<Doctor['ageGroup'], string> = {
    all: '',
    adult: '16+ yosh',
    child: '16 yoshgacha',
  };

  let doctors: Doctor[] = [];
  let shifts: Shift[] = [];
  let slotMinutes = 60;
  let ageGroup: Doctor['ageGroup'] = 'all';

  // ---------- yuklash ----------
  async function load() {
    let data: { doctors: Doctor[] };
    try {
      const res = await fetch('/api/admin-doctors', { credentials: 'same-origin' });
      if (res.status === 401 || res.status === 403) {
        const body = res.status === 403 ? ((await res.json()) as { telegramId?: string }) : {};
        showSignIn(
          res.status,
          [
            t('denied.admin', getLang()),
            body.telegramId
              ? `Sizning Telegram ID: ${body.telegramId} — buni Netlify’da ADMIN_TELEGRAM_IDS ga qo‘ying.`
              : '',
          ]
            .filter(Boolean)
            .join(' '),
          'denied',
        );
        return;
      }
      if (!res.ok) throw new Error(String(res.status));
      data = await res.json();
    } catch {
      el('loading').textContent = 'Ma’lumotlarni yuklab bo‘lmadi. Sahifani yangilang.';
      return;
    }

    doctors = data.doctors;
    el('loading').hidden = true;
    el('content').hidden = false;
    el('addBtn').hidden = false;
    const shown = doctors.filter((d) => d.active).length;
    el('subtitle').textContent =
      `${shown} ta shifokor saytda koʻrinadi` +
      (doctors.length > shown ? ` · ${doctors.length - shown} tasi yashirilgan` : '');
    renderList();
  }

  /*
    Ro'yxat bo'limlar bo'yicha guruhlanadi: admin klinikani qanday
    ko'rsa, ekranda ham shunday tursin. Shifokori qolmagan bo'lim
    alohida ogohlantirish bilan chiqadi — o'sha bo'limga saytdan
    navbat olib bo'lmaydi.
  */
  function renderList() {
    const order = Object.keys(DEPT_NAMES);
    const groups = [...new Set([...order, ...doctors.map((d) => d.deptId)])]
      .map((deptId) => ({
        deptId,
        name: DEPT_NAMES[deptId] ?? deptId,
        rows: doctors.filter((d) => d.deptId === deptId),
      }))
      .filter((g) => g.rows.length);

    el('list').innerHTML = groups
      .map((g) => {
        const shown = g.rows.filter((d) => d.active).length;
        return `<div class="dept-group">
          <div class="dept-head">
            <h2>${esc(g.name)}</h2>
            <span class="dept-note${shown ? '' : ' warn'}">${
              shown ? `${shown} ta shifokor saytda` : 'saytda koʻrinmaydi — navbat olib boʻlmaydi'
            }</span>
          </div>
          ${g.rows.map(row).join('')}
        </div>`;
      })
      .join('');

    el('list')
      .querySelectorAll<HTMLButtonElement>('[data-edit]')
      .forEach((b) => (b.onclick = () => openForm(b.dataset.edit!)));
    el('list')
      .querySelectorAll<HTMLButtonElement>('[data-off]')
      .forEach((b) => (b.onclick = () => setActive(b.dataset.off!, false)));
    el('list')
      .querySelectorAll<HTMLButtonElement>('[data-on]')
      .forEach((b) => (b.onclick = () => setActive(b.dataset.on!, true)));
  }

  /** Bitta shifokor qatori. */
  function row(d: Doctor): string {
    return `<div class="doc-row${d.active ? '' : ' off'}">
      <div class="doc-main">
        <span class="nm">${esc(d.name)}</span>
        <span class="meta">${esc(d.job)} · ${fmtPrice(d.price)} so‘m · ${d.slotMinutes} daqiqa${
          AGE_TEXT[d.ageGroup] ? ` · ${AGE_TEXT[d.ageGroup]}` : ''
        }${
          d.servicesText ? ` · ${d.servicesText.split('\n').filter(Boolean).length} ta qo‘shimcha xizmat` : ''
        }</span>
      </div>
      <div class="doc-tags">
        ${
          d.active
            ? '<span class="tag ok">saytda koʻrinadi</span>'
            : '<span class="tag off">yashirilgan</span>'
        }
        ${
          d.linked
            ? '<span class="tag ok">kabinetga kiradi</span>'
            : '<span class="tag warn" title="Telegram bogʻlanmagan — shifokor oʻz kabinetiga kira olmaydi">kabinetga kira olmaydi</span>'
        }
      </div>
      <div class="doc-btns">
        <button class="mini" data-edit="${d.id}">Tahrirlash</button>
        ${
          d.active
            ? `<button class="mini danger" data-off="${d.id}">Saytdan yashirish</button>`
            : `<button class="mini okbtn" data-on="${d.id}">Saytda koʻrsatish</button>`
        }
      </div>
    </div>`;
  }

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c);

  // ---------- forma ----------
  function openForm(id: string | null) {
    const d = id ? doctors.find((x) => x.id === id) ?? null : null;

    el('formTitle').textContent = d ? d.name : 'Yangi shifokor';
    setMsg('');

    el<HTMLInputElement>('f-id').value = d?.id ?? '';
    el<HTMLInputElement>('f-id').disabled = Boolean(d); // ID o'zgarmaydi
    el<HTMLInputElement>('f-name').value = d?.name ?? '';
    el<HTMLInputElement>('f-job').value = d?.job ?? '';
    el<HTMLSelectElement>('f-dept').value = d?.deptId ?? 'terapiya';
    el<HTMLInputElement>('f-price').value = d ? String(d.price) : '';
    el<HTMLInputElement>('f-exp').value = d?.experience ?? '';
    el<HTMLInputElement>('f-hours').value = d?.hours ?? '';
    el<HTMLInputElement>('f-photo').value = d?.photo ?? '';
    el<HTMLInputElement>('f-phone').value = d?.phone ?? '';
    el<HTMLTextAreaElement>('f-services').value = d?.servicesText ?? '';
    el<HTMLInputElement>('f-tg').value = d?.telegramId ?? '';
    el<HTMLInputElement>('f-active').checked = d ? d.active : true;

    slotMinutes = d?.slotMinutes ?? 60;
    renderSlotSeg();

    ageGroup = d?.ageGroup ?? 'all';
    renderAgeSeg();

    const days = d?.workdays ?? [1, 2, 3, 4, 5, 6];
    el('f-days')
      .querySelectorAll<HTMLInputElement>('input')
      .forEach((cb) => (cb.checked = days.includes(Number(cb.value))));

    shifts = (d?.shifts ?? [{ start: '09:00', end: '13:00' }]).map((s) => ({ ...s }));
    renderShifts();

    el('modal').hidden = false;
  }

  function closeForm() {
    el('modal').hidden = true;
  }

  function renderSlotSeg() {
    el('f-slot')
      .querySelectorAll<HTMLButtonElement>('button')
      .forEach((btn) => {
        btn.classList.toggle('on', Number(btn.dataset.min) === slotMinutes);
        btn.onclick = () => {
          slotMinutes = Number(btn.dataset.min);
          renderSlotSeg();
        };
      });
  }

  /** Yosh cheklovi tanlovi — slot davomiyligi bilan bir xil segment. */
  function renderAgeSeg() {
    el('f-age')
      .querySelectorAll<HTMLButtonElement>('button')
      .forEach((btn) => {
        btn.classList.toggle('on', btn.dataset.age === ageGroup);
        btn.onclick = () => {
          ageGroup = btn.dataset.age as Doctor['ageGroup'];
          renderAgeSeg();
        };
      });
  }

  function renderShifts() {
    el('f-shifts').innerHTML = shifts
      .map(
        (s, i) => `<div class="shift">
          <input type="time" value="${s.start}" data-i="${i}" data-k="start" aria-label="${i + 1}-smena boshlanishi">
          <span class="dash">–</span>
          <input type="time" value="${s.end}" data-i="${i}" data-k="end" aria-label="${i + 1}-smena tugashi">
          <button class="del" data-del="${i}" type="button" aria-label="Smenani o‘chirish">✕</button>
        </div>`,
      )
      .join('');

    el('f-shifts')
      .querySelectorAll<HTMLInputElement>('input[data-i]')
      .forEach((input) =>
        input.addEventListener('change', () => {
          const shift = shifts[Number(input.dataset.i)];
          if (shift) shift[input.dataset.k as 'start' | 'end'] = input.value;
        }),
      );
    el('f-shifts')
      .querySelectorAll<HTMLButtonElement>('[data-del]')
      .forEach((btn) =>
        btn.addEventListener('click', () => {
          if (shifts.length === 1) {
            setMsg('Kamida bitta smena qolishi kerak.', 'error');
            return;
          }
          shifts.splice(Number(btn.dataset.del), 1);
          renderShifts();
        }),
      );
  }

  const setMsg = (text: string, kind: 'error' | 'ok' | '' = '') => {
    const m = el('formMsg');
    m.textContent = text;
    m.className = `msg${kind ? ` ${kind}` : ''}`;
  };

  el('addShift').addEventListener('click', () => {
    const last = shifts.at(-1);
    shifts.push(last ? { start: last.end, end: last.end } : { start: '09:00', end: '13:00' });
    renderShifts();
  });

  async function save() {
    const workdays = [...el('f-days').querySelectorAll<HTMLInputElement>('input')]
      .filter((cb) => cb.checked)
      .map((cb) => Number(cb.value));

    const payload = {
      id: el<HTMLInputElement>('f-id').value.trim(),
      name: el<HTMLInputElement>('f-name').value.trim(),
      job: el<HTMLInputElement>('f-job').value.trim(),
      deptId: el<HTMLSelectElement>('f-dept').value,
      price: Number(el<HTMLInputElement>('f-price').value),
      slotMinutes,
      ageGroup,
      workdays,
      shifts,
      experience: el<HTMLInputElement>('f-exp').value.trim(),
      hours: el<HTMLInputElement>('f-hours').value.trim(),
      photo: el<HTMLInputElement>('f-photo').value.trim(),
      phone: el<HTMLInputElement>('f-phone').value.trim(),
      servicesText: el<HTMLTextAreaElement>('f-services').value,
      telegramId: el<HTMLInputElement>('f-tg').value.trim(),
      active: el<HTMLInputElement>('f-active').checked,
    };

    const btn = el<HTMLButtonElement>('saveForm');
    btn.disabled = true;
    setMsg('Saqlanmoqda…');
    try {
      const res = await fetch('/api/admin-doctors', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as { error?: string };
      if (!res.ok) {
        setMsg(data.error ?? 'Saqlab bo‘lmadi.', 'error');
        return;
      }
      closeForm();
      await load();
    } catch {
      setMsg('Internetga ulanishda muammo.', 'error');
    } finally {
      btn.disabled = false;
    }
  }

  async function setActive(id: string, active: boolean) {
    const doc = doctors.find((x) => x.id === id);
    const q = active
      ? `"${doc?.name}" saytda qayta ko‘rsatilsinmi?`
      : `"${doc?.name}" saytdan yashirilsinmi?\n\n` +
        `Bemorlar uni ko‘rmaydi va navbat ololmaydi. Ma’lumotlari va ` +
        `navbatlar tarixi saqlanadi — istalgan payt qaytarasiz.`;
    if (!confirm(q)) return;

    try {
      const res = await fetch('/api/admin-doctors', {
        method: 'DELETE',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id, active }),
      });
      if (!res.ok) {
        const data = (await res.json()) as { error?: string };
        alert(data.error ?? 'Bajarib bo‘lmadi.');
        return;
      }
      await load();
    } catch {
      alert('Internetga ulanishda muammo.');
    }
  }

  el('addBtn').addEventListener('click', () => openForm(null));
  el('closeForm').addEventListener('click', closeForm);
  el('cancelForm').addEventListener('click', closeForm);
  el('saveForm').addEventListener('click', save);
  el('modal').addEventListener('click', (e) => {
    if (e.target === el('modal')) closeForm();
  });
  load();
</script>

<style>
  .sub {
    display: block;
    color: var(--rose);
    font-weight: 650;
    font-size: 14px;
    margin-top: 4px;
  }

  .state {
    text-align: center;
    padding: 48px 0;
    color: var(--muted);
    font-size: 15px;
  }

  .state .btn {
    margin-top: 16px;
  }


  /* ---- ro'yxat ---- */
  /*
    Ro'yxat JS bilan (innerHTML) chiziladi. Astro uslublari faqat
    shablonda turgan elementlarga qamrov (scope) belgisi qo'yadi —
    JS qo'shgan tugunlarda u belgi bo'lmaydi va uslub qo'llanmaydi.
    Shu sababli quyidagilar :global() bilan yozilgan; aks holda
    butun ro'yxat bezaksiz matnga aylanadi.
  */
  .doc-rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .doc-rows :global(.doc-row) {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    border: 1px solid var(--card-brd);
    background: var(--chip-bg);
    border-radius: 14px;
    flex-wrap: wrap;
  }

  .doc-rows :global(.doc-row.off) {
    opacity: 0.55;
  }

  .doc-rows :global(.doc-main) {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .doc-rows :global(.doc-main .nm) {
    font-weight: 700;
    font-size: 15px;
  }

  .doc-rows :global(.doc-main .meta) {
    font-size: 12.5px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .doc-rows :global(.doc-tags) {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .doc-rows :global(.tag) {
    font-size: 12px;
    font-weight: 700;
    border-radius: 999px;
    padding: 4px 8px;
  }

  .doc-rows :global(.tag.ok) {
    color: var(--ok);
    background: var(--ok-bg);
  }

  .doc-rows :global(.tag.warn) {
    color: var(--warn);
    background: var(--warn-bg);
  }

  .doc-rows :global(.tag.off) {
    color: var(--muted);
    background: var(--busy);
  }

  .doc-rows :global(.doc-btns) {
    display: flex;
    gap: 8px;
  }

  .doc-rows :global(.mini) {
    border: 1px solid var(--card-brd);
    background: var(--card-bg);
    color: var(--ink);
    border-radius: 9px;
    padding: 8px 16px;
    font-size: 12.5px;
    font-weight: 650;
  }

  .doc-rows :global(.mini:hover) {
    border-color: var(--leaf);
  }

  .doc-rows :global(.mini.danger) {
    color: var(--rose);
  }

  .doc-rows :global(.mini.danger:hover) {
    border-color: var(--rose);
    background: var(--rose-soft);
  }

  .doc-rows :global(.mini.okbtn) {
    color: var(--leaf);
  }

  /* ---- modal ---- */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 24px 16px;
    overflow-y: auto;
    z-index: 50;
  }

  .modal-card {
    border-radius: 18px;
    padding: 24px;
    width: 100%;
    max-width: 560px;
    /* Shaffof "glass" fonda orqadagi sahifa matni ko'rinib, forma o'qilmasdi. */
    background: var(--card-solid);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    /* Ichidagi maydonlar oq-shaffof ranglar bilan chizilgan — qattiq fonda
       ko'rinmay qolardi: maydon foni va chegarasi shu oynada o'zgartiriladi. */
    --chip-bg: var(--bg);
    --card-brd: var(--line);
  }

  .modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .modal-head h2 {
    font-size: 18px;
    font-weight: 750;
  }

  .x {
    border: none;
    background: none;
    color: var(--muted);
    font-size: 16px;
